{
  "functions": {
    "source": "functions",
    "codebase": "default",
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  },
  "hosting": {
    "site": "astro-nova-idle",
    "public": "redirects-astro-nova-idle/public",
    "redirects": [
      {
        "source": "/legal/terms",
        "destination": "https://dynastynova.com/conditions-generales/",
        "type": 301
      },
      {
        "source": "/legal/cookies",
        "destination": "https://dynastynova.com/politique-de-confidentialite/",
        "type": 301
      },
      {
        "source": "/legal/privacy",
        "destination": "https://dynastynova.com/politique-de-confidentialite/",
        "type": 301
      },
      {
        "source": "/game",
        "destination": "https://dynastynova.com/",
        "type": 301
      },
      {
        "source": "/sitemap.xml",
        "destination": "https://dynastynova.com/sitemap-index.xml",
        "type": 301
      },
      {
        "source": "/",
        "destination": "https://dynastynova.com/",
        "type": 301
      },
      {
        "source": "/:path*",
        "destination": "https://dynastynova.com/:path*",
        "type": 301
      }
    ]
  }
}

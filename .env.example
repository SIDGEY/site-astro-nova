# ─────────────────────────────────────────────────────────────
# Dynasty Nova — variables d'environnement
# Copier en `.env` pour le dev local. Jamais commité.
# ─────────────────────────────────────────────────────────────

# GSC live (scripts/gsc-fetch.mjs) — compte de service Google Cloud (setup one-shot,
# voir en-tête du script). Le compte de service peut être réutilisé depuis un autre
# projet : il suffit de l'ajouter comme utilisateur en lecture sur cette propriété
# GSC (Paramètres > Utilisateurs et autorisations).
GSC_SERVICE_ACCOUNT_KEY_FILE="/chemin/vers/gsc-service-account.json"
GSC_SITE_URL="https://dynastynova.com/"   # propriété URL-prefix (pas sc-domain: cette propriété n'est pas vérifiée en domaine)

# GA4 live (scripts/ga4-fetch.mjs) — même compte de service que GSC (ajouté comme
# "Lecteur" dans GA4 > Admin > Gestion des accès à la propriété). Property ID
# NUMÉRIQUE (pas le Measurement ID G-XXXXXXX visible dans le tag du site).
GA4_SERVICE_ACCOUNT_KEY_FILE="/chemin/vers/gsc-service-account.json"
GA4_PROPERTY_ID="properties/468587506"

# PostHog (scripts/posthog-fetch.mjs) — conversion par page vers le jeu, lecture, frictions.
# Clé PERSONNELLE (phx_..., Settings > User > Personal API keys, scope « Query: read »),
# pas la clé projet phc_ du site (celle-là est publique, dans src/lib/posthog.ts).
POSTHOG_PERSONAL_API_KEY="phx_..."
POSTHOG_PROJECT_ID="308915"        # projet du site
POSTHOG_GAME_PROJECT_ID="218176"   # projet du jeu (inscriptions par page d'origine)
# POSTHOG_API_HOST="https://us.posthog.com"   # optionnel, défaut https://eu.posthog.com

# Vidiome (scripts/vidiome-generate.mjs) — mode vidéo du skill dynasty-article,
# optionnel. Clé API du compte Vidiome (vdm_live_...), même compte que beryldesign.
VIDIOME_API_KEY="vdm_live_..."
# VIDIOME_API_BASE="http://localhost:3000"   # optionnel, pour un serveur Vidiome local

# Cloudflare Workers AI (scripts/generate-cover.mjs) — génération de cover d'article
# unique, même compte que beryldesign (tier gratuit ~10k neurones/jour). Account ID :
# barre latérale droite du dashboard Cloudflare. API Token : My Profile > API Tokens
# > template "Workers AI".
CLOUDFLARE_ACCOUNT_ID="..."
CLOUDFLARE_API_TOKEN="..."

# Compte de jeu (capture des écrans de référence de play.dynastynova.com) — sert à vérifier que
# les écrans reconstruits de la home (src/components/game/) collent au jeu. Connexion au pseudo.
GAME_USERNAME=
GAME_PASSWORD=

# ─────────────────────────────────────────────────────────────
# Publicité payante (skill `ads`) — ces variables vont dans .env.local, jamais dans ce fichier
# ni dans un commit. Les scripts lisent .env.local puis .env.
# ─────────────────────────────────────────────────────────────

# Plafond de dépense journalier total, toutes régies (somme des budgets journaliers des campagnes
# actives). Sans lui, scripts/ads-google.mjs et scripts/ads-reddit.mjs refusent toute écriture.
ADS_DAILY_CAP_EUR=
# Taille minimale d'une cohorte pour appliquer le garde-fou de rétention J7 (défaut 10).
# ADS_MIN_COHORT=10
# Valeur estimée d'une inscription, envoyée avec les conversions importées (facultatif).
# ADS_SIGNUP_VALUE_EUR=
# Consentement « ad_user_data » réellement recueilli par la CMP, pour l'import de conversions
# (GRANTED ou DENIED). Laisser vide tant que ce n'est pas vérifié.
# ADS_CONSENT_AD_USER_DATA=

# Google Ads (scripts/ads-google.mjs, setup dans l'en-tête du script). Client OAuth « Application de
# bureau » du projet Google Cloud de GA4/GSC, jeton de rafraîchissement avec les scopes adwords et
# datamanager. Depuis le 2026-09-09, le jeton développeur est facultatif (ignoré par l'API) : l'accès
# aux comptes réels dépend du niveau Explorer du projet Cloud.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=          # compte annonceur, 10 chiffres sans tirets
GOOGLE_ADS_LOGIN_CUSTOMER_ID=    # MCC, si l'accès passe par un compte administrateur
# GOOGLE_ADS_DEVELOPER_TOKEN=
# Actions de conversion « importation de clics » (create-conversion-actions les crée et les affiche)
# GOOGLE_ADS_CONVERSION_SIGNUP_ID=
# GOOGLE_ADS_CONVERSION_PURCHASE_ID=

# Reddit Ads (scripts/ads-reddit.mjs, setup dans l'en-tête du script). App du Developer Portal du
# Business Manager Reddit, scopes adsread, adsedit, adsconversions ; le jeton de rafraîchissement
# est écrit dans .env.local par `node scripts/ads-reddit.mjs token`.
REDDIT_ADS_CLIENT_ID=
REDDIT_ADS_CLIENT_SECRET=
REDDIT_ADS_REFRESH_TOKEN=
REDDIT_ADS_ACCOUNT_ID=           # a2_...
REDDIT_ADS_PIXEL_ID=             # obligatoire sur tout groupe d'annonces
# REDDIT_ADS_USER_AGENT=

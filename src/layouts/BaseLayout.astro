---
import SEO from "../components/SEO.astro";
import Header from "../components/Header.astro";
import GameFooter from "../components/GameFooter.astro";
import "../styles/global.css";
import "@fontsource/lexend/300.css";
import "@fontsource/lexend/400.css";
import "@fontsource/lexend/500.css";
import "@fontsource/lexend/600.css";
import "@fontsource/lexend/700.css";
import "@phosphor-icons/web/regular";
import "@phosphor-icons/web/bold";
import "@phosphor-icons/web/fill";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  index?: boolean;
  follow?: boolean;
  articleData?: {
    datePublished: Date;
    author: string;
  };
  breadcrumbs?: { name: string; item: string }[];
  canonicalURL?: string;
  faqItems?: { question: string; answer: string }[];
}

const {
  title,
  description,
  image,
  type,
  index,
  follow,
  articleData,
  breadcrumbs,
  canonicalURL,
  faqItems,
} = Astro.props;
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-JCW3KYPJ2Z"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-JCW3KYPJ2Z');
    </script>

    <script src="https://analytics.ahrefs.com/analytics.js" data-key="Njsu9ueedXAcaloDTE8htg" async></script>

    <link href="admin/config.yml" type="text/yaml" rel="cms-config-url" />
    <SEO
      {title}
      {description}
      {image}
      {type}
      {index}
      {follow}
      {articleData}
      {breadcrumbs}
      {canonicalURL}
      {faqItems}
    />
  </head>
  <body
    class="bg-[rgb(var(--bg))] text-[rgb(var(--text))] transition-colors duration-300"
  >
    <!-- Netlify Identity (needed to handle invite/recovery links that land on the site root) -->
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"
    ></script>
    <script>
      // Redirect invite/recovery links to the CMS admin so Decap can complete auth.
      if (
        window.location.hash &&
        /(invite_token|recovery_token)=/i.test(window.location.hash)
      ) {
        window.location.href = "/admin/" + window.location.hash;
      }
    </script>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 bg-primary text-primary-contrast p-4 rounded-lg z-[100] font-bold"
    >
      Passer au contenu principal
    </a>

    <Header />

    <main id="main-content" class="flex-grow outline-none" tabindex="-1">
      <slot />
    </main>

    <GameFooter />

    <script>
      // Le départ vers le jeu est la conversion principale du site depuis l'arrêt
      // de la liste d'attente. Délégation sur document plutôt qu'un handler par
      // bouton : couvre l'en-tête, le menu mobile, les héros et le pied de page,
      // y compris les CTA saisis depuis le CMS qui ne passent par aucun composant.
      import { trackEvent } from "../lib/tracking";

      const PLAY_HOST = "play.dynastynova.com";
      const ORIGIN_KEY = "dn_session_origin";
      const UTM_KEYS = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"];

      // Origine de la visite, retenue à la première page de la session : sans elle, le jeu ne
      // voit arriver que « dynastynova.com » et ne sait pas qui vient de LinkedIn, d'un e-mail
      // ou de Google (le jeu la capte en premier contact, voir Frontend `lib/attribution.ts`).
      const rememberOrigin = () => {
        try {
          if (sessionStorage.getItem(ORIGIN_KEY)) return;
          const params = new URLSearchParams(window.location.search);
          const origin: Record<string, string> = {};
          for (const key of UTM_KEYS) {
            const value = params.get(key);
            if (value) origin[key] = value.slice(0, 100);
          }
          if (!origin.utm_source && document.referrer) {
            const host = new URL(document.referrer).hostname;
            if (host && !host.endsWith("dynastynova.com")) {
              origin.utm_source = host;
              origin.utm_medium = "referral";
            }
          }
          sessionStorage.setItem(ORIGIN_KEY, JSON.stringify(origin));
        } catch {
          // Stockage refusé : les liens partent sans origine, comme avant.
        }
      };
      rememberOrigin();

      // Ajoute l'origine au lien vers le jeu, juste avant la navigation. Priorité : l'origine
      // réelle de la session, puis les UTM déjà posés sur le lien (CTA d'article), puis le site.
      const tagPlayLink = (link: HTMLAnchorElement) => {
        try {
          const url = new URL(link.href, window.location.href);
          let origin: Record<string, string> = {};
          try {
            origin = JSON.parse(sessionStorage.getItem(ORIGIN_KEY) || "{}");
          } catch {
            origin = {};
          }
          if (origin.utm_source) {
            for (const key of UTM_KEYS) {
              if (origin[key]) url.searchParams.set(key, origin[key]);
              else url.searchParams.delete(key);
            }
          } else if (!url.searchParams.get("utm_source")) {
            url.searchParams.set("utm_source", "dynastynova.com");
            url.searchParams.set("utm_medium", "site");
            url.searchParams.set("utm_campaign", window.location.pathname.replace(/^\/|\/$/g, "") || "home");
          }
          link.href = url.toString();
        } catch {
          // URL illisible : le lien part tel quel.
        }
      };

      document.addEventListener("click", (event) => {
        const link = (event.target as Element | null)?.closest?.("a[href]") as
          | HTMLAnchorElement
          | null;
        if (!link) return;

        let host: string;
        try {
          host = new URL(link.href, window.location.href).host;
        } catch {
          return; // href non parsable (mailto:, javascript:...) — rien à tracker.
        }
        if (host !== PLAY_HOST) return;

        tagPlayLink(link);
        trackEvent("play_click", {
          // Distingue le bouton d'en-tête d'un CTA de bas de page.
          link_text: link.textContent?.trim().slice(0, 100) || "",
          page_path: window.location.pathname,
          // La navigation quitte le site dans la foulée : sendBeacon survit à
          // l'unload, là où une requête classique serait annulée avant d'arriver.
          transport_type: "beacon",
        });
      });
    </script>
  </body>
</html>

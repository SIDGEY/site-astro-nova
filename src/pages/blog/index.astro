---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getArticleIcon, LOGO_ICON } from "../../utils/articleIcon";

const articles = await getCollection(
  "articles",
  ({ data }) => data.draft !== true,
);
articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const COVERS = Array.from(
  { length: 27 },
  (_, i) => `/uploads/blog/covers/cover-${i + 1}.webp`,
);
function getFallbackCover(slug: string): string {
  let hash = 0;
  for (let i = 0; i < slug.length; i++)
    hash = (hash * 31 + slug.charCodeAt(i)) >>> 0;
  return COVERS[hash % COVERS.length];
}
---

<BaseLayout
  title="Blog - Dynasty Nova"
  description="Guides, actualités et conseils stratégiques pour devenir un maître de la galaxie."
>
  <!-- Hero header -->
  <div class="bg-[#1d293d] relative flex flex-col items-center w-full pt-20">
    <div
      class="absolute bg-gradient-to-b from-[#0f172b] h-72 left-0 right-0 to-[#1d293d] top-0 pointer-events-none"
    >
    </div>
    <div
      class="relative z-10 px-6 md:px-12 lg:px-36 py-12 md:py-24 w-full max-w-[1440px] flex items-center justify-center"
    >
      <div class="flex flex-col gap-6 items-center w-full text-center">
        <h1 class="text-4xl md:text-5xl lg:text-[60px] font-bold text-slate-50 leading-tight md:leading-[1.1]">
          Blog Dynasty Nova
        </h1>
        <p class="text-lg md:text-2xl text-[#90a1b9] font-normal leading-[1.3] max-w-2xl">
          Guides, actualités et conseils stratégiques pour devenir un maître de
          la galaxie.
        </p>
      </div>
    </div>
  </div>

  <!-- Diagonal separator -->
  <div class="relative w-full h-12 md:h-24 shrink-0">
    <svg
      class="absolute inset-0 w-full h-full"
      fill="none"
      preserveAspectRatio="none"
      viewBox="0 0 1440 96"
    >
      <rect width="1440" height="96" fill="#1D293D"></rect>
      <path d="M0 0L1440 96V96H0V0Z" fill="#0F172B"></path>
    </svg>
  </div>

  <!-- Articles grid -->
  <section
    class="relative bg-slate-900 py-20 md:py-[128px] px-6 md:px-12 lg:px-20 flex items-center"
  >
    <div class="relative z-[2] max-w-7xl mx-auto w-full grid items-center">
      <div
        class="grid grid-cols-1 gap-y-8 sm:grid-cols-2 sm:gap-x-8 sm:gap-y-16 lg:grid-cols-3"
      >
        {
          articles.map((article) => (
            <a
              href={`/blog/${article.id}`}
              class="news-card card-with-border group rounded-xl overflow-hidden no-underline"
            >
              <div class="aspect-[5/3] rounded-xl w-full relative flex shrink-0 items-center justify-center overflow-hidden border bg-slate-800 border-slate-700/50 transition-colors">
                <img
                  src={article.data.image ?? getFallbackCover(article.id)}
                  alt={article.data.title}
                  class="card-image absolute inset-0 w-full h-full object-cover"
                />
                <div class="overlay absolute inset-0" />
                <div class="card-rings absolute inset-0 flex items-center justify-center pointer-events-none">
                  <div
                    class="ring ring-1 absolute rounded-full"
                    style="width:340px;height:340px;padding:1px;background:linear-gradient(to bottom, white, rgba(255,255,255,0.4));-webkit-mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);-webkit-mask-composite:destination-out;mask-composite:exclude"
                  />
                  <div
                    class="ring ring-2 absolute rounded-full"
                    style="width:250px;height:250px;padding:1px;background:linear-gradient(to bottom, white, rgba(255,255,255,0.4));-webkit-mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);-webkit-mask-composite:destination-out;mask-composite:exclude"
                  />
                  <div
                    class="ring ring-3 absolute rounded-full"
                    style="width:175px;height:175px;padding:1px;background:linear-gradient(to bottom, white, rgba(255,255,255,0.4));-webkit-mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);-webkit-mask-composite:destination-out;mask-composite:exclude"
                  />
                  <div
                    class="ring ring-4 absolute rounded-full"
                    style="width:110px;height:110px;padding:1px;background:linear-gradient(to bottom, white, rgba(255,255,255,0.4));-webkit-mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);-webkit-mask-composite:destination-out;mask-composite:exclude"
                  />
                  {getArticleIcon(article.data.tags, article.data.icon) ===
                  LOGO_ICON ? (
                    <svg
                      class="relative z-10 text-slate-200"
                      width="48"
                      height="53"
                      viewBox="0 0 58 64"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M57.6 44.2556L57.2486 44.2333C52.4991 43.6195 47.702 43.157 42.8625 42.8514L28.8 64L14.7375 42.8514C9.89795 43.157 5.10092 43.6195 0.351389 44.2333L0 44.2556L28.8 0L57.6 44.2556ZM17.3736 34.975L22.6486 37.5917L28.8 46.8417L34.9514 37.5917L40.225 34.975L28.8 17.4167L17.3736 34.975Z"
                        fill="currentColor"
                      />
                    </svg>
                  ) : (
                    <i
                      class={`ph ${getArticleIcon(article.data.tags, article.data.icon)} relative z-10 text-4xl text-slate-200`}
                    />
                  )}
                </div>
              </div>
              <div class="px-8 pt-6 pb-8">
                <h2 class="text-xl font-semibold text-slate-100 mb-3 line-clamp-2">
                  {article.data.title}
                </h2>
                <p class="text-base text-slate-400 leading-relaxed mb-0 line-clamp-3">
                  {article.data.description}
                </p>
              </div>
            </a>
          ))
        }
      </div>

    </div>
  </section>
</BaseLayout>


<style>
  .news-card {
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .news-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 48px 0px rgba(0, 0, 0, 0.18);
  }

  /* Repos — hover-out : de l'extérieur vers l'intérieur */
  .ring-1 {
    opacity: 0.06;
    transform: scale(1);
    transition:
      opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 0s;
  }
  .ring-2 {
    opacity: 0.1;
    transform: scale(1);
    transition:
      opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 0s;
  }
  .ring-3 {
    opacity: 0.16;
    transform: scale(1);
    transition:
      opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 0s;
  }
  .ring-4 {
    opacity: 0.25;
    transform: scale(1);
    transition:
      opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 0s;
  }

  /* Hover-in : du centre vers l'extérieur */
  .news-card:hover .ring-4 {
    opacity: 0.55;
    transform: scale(1.07);
    transition-delay: 0s;
  }
  .news-card:hover .ring-3 {
    opacity: 0.35;
    transform: scale(1.07);
    transition-delay: 0.07s;
  }
  .news-card:hover .ring-2 {
    opacity: 0.22;
    transform: scale(1.07);
    transition-delay: 0.14s;
  }
  .news-card:hover .ring-1 {
    opacity: 0.14;
    transform: scale(1.07);
    transition-delay: 0.21s;
  }

  .news-card .card-image {
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .news-card:hover .card-image {
    transform: scale(1.05);
  }

  .news-card .overlay {
    background-color: rgba(15, 23, 42, 0.4);
    transition: background-color 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .news-card:hover .overlay {
    background-color: rgba(15, 23, 42, 0.2);
  }
</style>

---
import ArticleView from "../../components/blog/ArticleView.astro";
import { getArticles } from "../../lib/articles";

export async function getStaticPaths() {
  // Un brouillon ne doit avoir aucune URL : sans ce filtre, il était généré et indexable,
  // seulement absent de la liste du blog. getArticles ne rend que les articles publiés.
  const articles = await getArticles("fr");
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
---

<ArticleView {article} />

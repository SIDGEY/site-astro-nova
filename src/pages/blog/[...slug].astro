---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getArticleIcon, LOGO_ICON } from "../../utils/articleIcon";
import { SITE_URL } from "../../lib/seo";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);

const tocHeadings = headings.filter((h) => h.depth === 2);

const wordCount = (article.body ?? "").split(/\s+/).length;
const readTime = Math.max(1, Math.round(wordCount / 200));

const category = article.data.tags[0] ?? "Article";

const COVERS = Array.from(
  { length: 27 },
  (_, i) => `/uploads/blog/covers/cover-${i + 1}.webp`,
);
function getFallbackCover(slug: string): string {
  let hash = 0;
  for (let i = 0; i < slug.length; i++)
    hash = (hash * 31 + slug.charCodeAt(i)) >>> 0;
  return COVERS[hash % COVERS.length];
}

const allArticles = await getCollection(
  "articles",
  ({ data }) => data.draft !== true,
);
allArticles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const relatedArticles = allArticles
  .filter((a) => a.id !== article.id)
  .slice(0, 3);

const canonicalURL = `${SITE_URL}/blog/${article.id}`;
const breadcrumbs = [
  { name: "Accueil", item: `${SITE_URL}/` },
  { name: "Blog", item: `${SITE_URL}/blog` },
  { name: article.data.title, item: canonicalURL },
];
const coverImage = article.data.image ?? getFallbackCover(article.id);
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  image={coverImage}
  type="article"
  articleData={{ datePublished: article.data.date, author: article.data.author }}
  {canonicalURL}
  {breadcrumbs}
  faqItems={article.data.faq}
>
  <!-- Hero header -->
  <div class="bg-[#1d293d] relative flex flex-col items-center w-full pt-20">
    <div
      class="absolute bg-gradient-to-b from-[#0f172b] h-72 left-0 right-0 to-[#1d293d] top-0 pointer-events-none"
    >
    </div>

    <div
      class="relative z-10 w-full max-w-[1440px] px-6 md:px-12 lg:px-36 py-12 md:py-24"
    >
      <div class="flex flex-col gap-6 items-start">
        <!-- Back -->
        <a
          href="/blog"
          class="flex items-center gap-3 text-[#62748e] hover:text-slate-300 transition-colors group"
        >
          <span
            class="flex items-center justify-center w-8 h-8 rounded-full border border-slate-700 group-hover:border-slate-500 transition-colors shrink-0"
          >
            <i class="ph ph-caret-left ph-bold text-sm text-slate-500"></i>
          </span>
          <span class="text-sm text-slate-400">Retour</span>
        </a>

        <!-- Title -->
        <h1
          class="text-4xl md:text-5xl lg:text-[60px] font-bold text-slate-50 leading-tight md:leading-[60px]"
        >
          {article.data.title}
        </h1>

        <!-- Meta -->
        <div class="flex items-center gap-6">
          <div class="flex items-center gap-1.5 text-slate-400 text-sm">
            <i class="ph ph-calendar-blank ph-bold text-base"></i>
            <time
              >{
                article.data.date.toLocaleDateString("fr-FR", {
                  day: "numeric",
                  month: "long",
                  year: "numeric",
                })
              }</time
            >
          </div>
          <div class="flex items-center gap-1.5 text-slate-400 text-sm">
            <i class="ph ph-clock-countdown ph-bold text-base"></i>
            <span>{readTime} min de lecture</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Diagonal separator -->
  <div class="relative w-full h-12 md:h-24 shrink-0">
    <svg
      class="absolute inset-0 w-full h-full"
      fill="none"
      preserveAspectRatio="none"
      viewBox="0 0 1440 96"
    >
      <rect width="1440" height="96" fill="#1D293D"></rect>
      <path d="M0 0L1440 96V96H0V0Z" fill="#0F172B"></path>
    </svg>
  </div>

  <!-- Article content + TOC -->
  <section class="bg-[#0f172b] w-full">
    <div
      class="max-w-[1440px] mx-auto px-6 md:px-12 lg:px-36 py-12 md:py-24 flex gap-16 items-start justify-center"
    >
      <!-- Main content -->
      <div
        id="article-content"
        class="flex flex-col gap-16 items-start max-w-[768px] w-full shrink-0 article-content"
      >
        <Content />

        {
          article.data.faq && article.data.faq.length > 0 && (
            <div class="w-full flex flex-col gap-6">
              <h2 class="text-2xl font-bold text-slate-100 mb-0">Questions fréquentes</h2>
              <div class="flex flex-col gap-3">
                {article.data.faq.map((item) => (
                  <details class="group bg-slate-800/60 border border-slate-700 rounded-xl overflow-hidden">
                    <summary class="flex justify-between items-center gap-4 p-5 cursor-pointer list-none font-semibold text-slate-100">
                      {item.question}
                      <i class="ph ph-caret-down text-slate-400 shrink-0 group-open:rotate-180 transition-transform duration-200" />
                    </summary>
                    <p class="px-5 pb-5 text-slate-400 leading-relaxed mb-0">{item.answer}</p>
                  </details>
                ))}
              </div>
            </div>
          )
        }
      </div>

      <!-- TOC sidebar -->
      {
        tocHeadings.length > 0 && (
          <aside
            id="toc-sidebar"
            class="w-[320px] shrink-0 sticky top-28 hidden xl:flex flex-col gap-0"
          >
            {tocHeadings.map((heading) => (
              <a
                href={`#${heading.slug}`}
                data-toc-link={heading.slug}
                class="toc-link relative w-full border-l border-[#1d293d] flex items-start pl-6 py-2 no-underline transition-colors duration-200 hover:border-[#51a2ff]"
              >
                <span class="toc-label text-base leading-[26px] font-normal text-[#62748e] transition-colors duration-200">
                  {heading.text}
                </span>
              </a>
            ))}
          </aside>
        )
      }
    </div>
  </section>

  <!-- Related articles -->
  {
    relatedArticles.length > 0 && (
      <section class="bg-slate-900 py-20 md:py-[128px] px-6 lg:px-8">
        <div class="max-w-7xl mx-auto w-full">
          <div class="text-center mb-12">
            <p class="text-xs uppercase tracking-widest text-slate-500 mb-3">
              Plus d'articles
            </p>
            <h2 class="text-3xl md:text-4xl font-bold text-slate-50 mb-0">
              Vous pourriez également être intéressé
            </h2>
          </div>
          <div class="related-track flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth scrollbar-hide -mx-6 px-6 sm:mx-0 sm:px-0 sm:gap-x-8 sm:gap-y-16 sm:overflow-visible sm:grid sm:grid-cols-2 lg:grid-cols-3">
            {relatedArticles.map((rel) => (
              <a
                href={`/blog/${rel.id}`}
                class="related-card card-with-border group flex-shrink-0 w-[87%] snap-center sm:w-auto rounded-xl overflow-hidden no-underline"
              >
                <div class="aspect-[5/3] rounded-xl w-full relative flex shrink-0 items-center justify-center overflow-hidden border bg-slate-800 border-slate-700/50">
                  <img
                    src={rel.data.image ?? getFallbackCover(rel.id)}
                    alt={rel.data.title}
                    class="rel-image absolute inset-0 w-full h-full object-cover"
                  />
                  <div class="rel-overlay absolute inset-0" />
                  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                    <div
                      class="rel-ring rel-ring-1 absolute rounded-full"
                      style="width:340px;height:340px;padding:1px;background:linear-gradient(to bottom, white, rgba(255,255,255,0.4));-webkit-mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);-webkit-mask-composite:destination-out;mask-composite:exclude"
                    />
                    <div
                      class="rel-ring rel-ring-2 absolute rounded-full"
                      style="width:250px;height:250px;padding:1px;background:linear-gradient(to bottom, white, rgba(255,255,255,0.4));-webkit-mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);-webkit-mask-composite:destination-out;mask-composite:exclude"
                    />
                    <div
                      class="rel-ring rel-ring-3 absolute rounded-full"
                      style="width:175px;height:175px;padding:1px;background:linear-gradient(to bottom, white, rgba(255,255,255,0.4));-webkit-mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);-webkit-mask-composite:destination-out;mask-composite:exclude"
                    />
                    <div
                      class="rel-ring rel-ring-4 absolute rounded-full"
                      style="width:110px;height:110px;padding:1px;background:linear-gradient(to bottom, white, rgba(255,255,255,0.4));-webkit-mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);-webkit-mask-composite:destination-out;mask-composite:exclude"
                    />
                    {getArticleIcon(rel.data.tags, rel.data.icon) ===
                    LOGO_ICON ? (
                      <svg
                        class="relative z-10 text-slate-200"
                        width="48"
                        height="53"
                        viewBox="0 0 58 64"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M57.6 44.2556L57.2486 44.2333C52.4991 43.6195 47.702 43.157 42.8625 42.8514L28.8 64L14.7375 42.8514C9.89795 43.157 5.10092 43.6195 0.351389 44.2333L0 44.2556L28.8 0L57.6 44.2556ZM17.3736 34.975L22.6486 37.5917L28.8 46.8417L34.9514 37.5917L40.225 34.975L28.8 17.4167L17.3736 34.975Z"
                          fill="currentColor"
                        />
                      </svg>
                    ) : (
                      <i
                        class={`ph ${getArticleIcon(rel.data.tags, rel.data.icon)} relative z-10 text-4xl text-slate-200`}
                      />
                    )}
                  </div>
                </div>
                <div class="px-8 pt-6 pb-8">
                  <h3 class="text-xl font-semibold text-slate-100 mb-3 line-clamp-2">
                    {rel.data.title}
                  </h3>
                  <p class="text-base text-slate-400 leading-relaxed mb-0 line-clamp-3">
                    {rel.data.description}
                  </p>
                </div>
              </a>
            ))}
          </div>
          <div class="related-dots flex sm:hidden justify-center gap-0 mt-8 overflow-hidden"></div>
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>(".related-track").forEach((track) => {
    const section = track.closest("section");
    const dotsContainer = section?.querySelector<HTMLElement>(".related-dots");
    const cards = Array.from(track.querySelectorAll<HTMLElement>(".related-card"));
    if (!cards.length || !dotsContainer) return;

    let currentPage = 0;
    let dots: HTMLButtonElement[] = [];
    const WIN = 5;
    const DOT_PX = [6, 5, 4];
    const DOT_OPACITY = [1, 0.4, 0.2];
    const DOT_COLOR = "rgb(226,232,240)";

    function winStart(page: number, total: number) {
      const w = Math.min(WIN, total);
      return Math.max(0, Math.min(page - Math.floor(w / 2), total - w));
    }
    function applyDots(page: number) {
      const total = dots.length;
      const ws = winStart(page, total);
      const we = ws + Math.min(WIN, total);
      dots.forEach((btn, i) => {
        const dot = btn.querySelector<HTMLSpanElement>("span")!;
        const inWin = i >= ws && i < we;
        const dist = Math.abs(i - page);
        if (!inWin) { btn.style.width = "0"; btn.style.padding = "0"; }
        else {
          const idx = Math.min(dist, DOT_PX.length - 1);
          btn.style.width = ""; btn.style.padding = "4px";
          dot.style.width = DOT_PX[idx] + "px"; dot.style.height = DOT_PX[idx] + "px";
          dot.style.backgroundColor = DOT_COLOR; dot.style.opacity = String(DOT_OPACITY[idx]);
          dot.style.boxShadow = idx === 0 ? `0 0 0 2px ${DOT_COLOR}` : "";
        }
      });
    }
    function nearestPage() {
      if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 2) return cards.length - 1;
      if (track.scrollLeft <= 2) return 0;
      const center = track.scrollLeft + track.clientWidth / 2;
      let closest = 0, minDist = Infinity;
      cards.forEach((card, i) => {
        const dist = Math.abs(card.offsetLeft + card.clientWidth / 2 - center);
        if (dist < minDist) { minDist = dist; closest = i; }
      });
      return closest;
    }
    function goToPage(page: number) {
      currentPage = page; applyDots(page);
      const card = cards[page];
      const offset = card.offsetLeft - (track.clientWidth - card.clientWidth) / 2;
      track.scrollTo({ left: Math.max(0, offset), behavior: "smooth" });
    }
    function buildDots() {
      dotsContainer!.innerHTML = "";
      dots = cards.map((_, i) => {
        const btn = document.createElement("button");
        btn.style.cssText = "display:flex;align-items:center;justify-content:center;cursor:pointer;transition:width 300ms ease,padding 300ms ease;overflow:hidden;";
        btn.setAttribute("aria-label", `Page ${i + 1}`);
        const dot = document.createElement("span");
        dot.style.cssText = "display:block;border-radius:9999px;transition:width 300ms ease,height 300ms ease,background-color 300ms ease,box-shadow 300ms ease;";
        btn.appendChild(dot);
        btn.addEventListener("click", () => goToPage(i));
        dotsContainer!.appendChild(btn);
        return btn;
      });
      applyDots(currentPage);
    }
    track.addEventListener("scroll", () => {
      const page = nearestPage();
      if (page !== currentPage) { currentPage = page; applyDots(page); }
    }, { passive: true });
    buildDots();
  });
</script>

<style>
  .article-content :global(h2) {
    font-size: 36px;
    font-weight: 700;
    color: #e2e8f0;
    line-height: 40px;
    margin-top: 64px;
    margin-bottom: 16px;
  }

  /* First h2 has no preceding element — skip the 80px top margin */
  .article-content :global(h2:first-child) {
    margin-top: 0;
  }

  .article-content :global(h3) {
    font-size: 18px;
    font-weight: 700;
    color: #e2e8f0;
    line-height: 28px;
    text-transform: uppercase;
    margin-top: 16px;
    margin-bottom: 0;
  }

  /* h3 directly after h2: h2 margin-bottom already gives 32px, don't double */
  .article-content :global(h2 + h3) {
    margin-top: 0;
  }

  .article-content :global(p) {
    font-size: 16px;
    color: #94a3b8;
    line-height: 26px;
    margin-top: 0;
    margin-bottom: 0;
  }

  .article-content :global(strong) {
    font-weight: 700;
    color: #e2e8f0;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    color: #94a3b8;
    font-size: 16px;
    line-height: 24px;
    padding-left: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
  }

  .article-content :global(li) {
    list-style: disc;
  }

  .article-content :global(blockquote) {
    border-left: 3px solid #334155;
    padding-left: 24px;
    color: #64748b;
    font-style: italic;
    margin: 0;
  }

  .article-content :global(img) {
    display: block;
    width: 100%;
    border-radius: 12px;
    border: 1px solid #334155;
    box-shadow:
      0 10px 15px -3px rgba(15, 23, 42, 0.5),
      0 4px 6px -4px rgba(15, 23, 42, 0.5);
  }

  /* Image+caption block: 80px above and below */
  .article-content :global(p:has(img)) {
    margin-top: 64px;    /* gap(16) + 64 = 80px */
    margin-bottom: 64px; /* gap(16) + 64 = 80px */
  }

  /* h2 already has margin-bottom: 16px — compensate to keep total at 80px */
  .article-content :global(h2 + p:has(img)) {
    margin-top: 48px; /* gap(16) + h2-mb(16) + 48 = 80px */
  }

  /* h3/h2 after image: their own margin-top would over-add — reset it */
  .article-content :global(p:has(img) + h3) {
    margin-top: 0; /* gap(16) + img-mb(64) + 0 = 80px */
  }

  .article-content :global(p:has(img) + h2) {
    margin-top: 0; /* gap(16) + img-mb(64) + 0 = 80px */
  }

  .article-content :global(hr) {
    border-color: #1e293b;
    margin: 0;
  }

  .article-content :global(em) {
    font-style: normal;
    font-size: 14px;
    color: #64748b;
    display: block;
    text-align: center;
    margin-top: 12px;
  }

  .article-content :global(> *) {
    width: 100%;
  }

  .article-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .toc-link.active {
    border-left-color: #51a2ff;
  }

  .toc-link.active .toc-label {
    color: #e2e8f0;
    font-weight: 500;
  }

  .related-card {
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .related-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 48px 0px rgba(0, 0, 0, 0.18);
  }

  .rel-ring-1 {
    opacity: 0.06;
    transform: scale(1);
    transition:
      opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 0s;
  }
  .rel-ring-2 {
    opacity: 0.1;
    transform: scale(1);
    transition:
      opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 0s;
  }
  .rel-ring-3 {
    opacity: 0.16;
    transform: scale(1);
    transition:
      opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 0s;
  }
  .rel-ring-4 {
    opacity: 0.25;
    transform: scale(1);
    transition:
      opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 0s;
  }

  .related-card:hover .rel-ring-4 {
    opacity: 0.55;
    transform: scale(1.07);
    transition-delay: 0s;
  }
  .related-card:hover .rel-ring-3 {
    opacity: 0.35;
    transform: scale(1.07);
    transition-delay: 0.07s;
  }
  .related-card:hover .rel-ring-2 {
    opacity: 0.22;
    transform: scale(1.07);
    transition-delay: 0.14s;
  }
  .related-card:hover .rel-ring-1 {
    opacity: 0.14;
    transform: scale(1.07);
    transition-delay: 0.21s;
  }

  .related-card .rel-image {
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .related-card:hover .rel-image {
    transform: scale(1.05);
  }

  .related-card .rel-overlay {
    background-color: rgba(15, 23, 42, 0.4);
    transition: background-color 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .related-card:hover .rel-overlay {
    background-color: rgba(15, 23, 42, 0.2);
  }
</style>

<script>
  const tocLinks =
    document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");

  if (tocLinks.length > 0) {
    const headingEls = Array.from(tocLinks)
      .map((link) => {
        const slug = link.dataset.tocLink!;
        return document.getElementById(slug);
      })
      .filter((el): el is HTMLElement => el !== null);

    let activeSlug = headingEls[0]?.id ?? "";

    function setActive(slug: string) {
      if (slug === activeSlug) return;
      activeSlug = slug;
      tocLinks.forEach((link) => {
        const isActive = link.dataset.tocLink === slug;
        link.classList.toggle("active", isActive);
      });
    }

    // Activate first item by default
    if (tocLinks[0]) tocLinks[0].classList.add("active");

    const HEADER_HEIGHT = 80; // matches pt-20 / fixed header

    const observer = new IntersectionObserver(
      (entries) => {
        // Find the topmost heading currently intersecting
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

        if (visible.length > 0) {
          setActive(visible[0].target.id);
          return;
        }

        // When scrolling past headings (none intersecting), find the last one above the header bottom
        const above = headingEls
          .filter((el) => el.getBoundingClientRect().top < HEADER_HEIGHT)
          .at(-1);

        if (above) setActive(above.id);
      },
      { rootMargin: `-${HEADER_HEIGHT}px 0px -55% 0px`, threshold: 0 },
    );

    headingEls.forEach((el) => observer.observe(el));
  }
</script>

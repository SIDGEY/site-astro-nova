---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockRenderer from '../components/BlockRenderer.astro';

const homeEntry = await getEntry('pages', 'home');

if (!homeEntry) {
  return Astro.redirect('/404');
}
const { title, description, blocks, sectionVariants } = homeEntry.data;
const english = await getEntry('pages', 'en/home');
---

<BaseLayout description={description} title={title} alternates={{ fr: '/', ...(english ? { en: '/en/' } : {}) }}>
  <BlockRenderer {blocks} {sectionVariants} />
</BaseLayout>

---
interface Props {
  title: string;
  subtitle: string;
  ctaText: string;
  ctaLink: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
  screenshot1?: string;
  screenshot2?: string;
  backgroundImage?: string;
}

const {
  title,
  subtitle,
  ctaText,
  ctaLink,
  secondaryCtaText = "Découvrir le jeu",
  secondaryCtaLink = "#features",
  backgroundImage = "/landing/backgrounds/bg-hero.webp",
} = Astro.props;
---

<header
  class="overflow-hidden relative bg-[#121B2E] min-h-[90dvh] flex items-center"
>
  <!-- Background image layers (reversed style: image on right) -->
  <div
    class="absolute inset-0 z-[0] pointer-events-none w-full h-full bg-[#121B2E]"
  >
    <!-- Mobile: image pleine largeur avec gradient vers le haut uniquement -->
    <div
      class="absolute opacity-25 inset-0 md:hidden"
      style={`background: url('${backgroundImage}'); background-repeat: no-repeat; background-position: center right 25%; background-size: cover;`}
    >
    </div>
    <div
      class="absolute inset-0 md:hidden"
      style="background: linear-gradient(16.11deg, #121B2E 0%, rgba(18, 27, 46, 0) 100%);"
    >
    </div>
    <!-- Desktop: image 75% avec gradients en diagonal -->
    <div
      class="absolute hidden md:block opacity-80 top-0 bottom-0 w-[75%] right-0 left-auto"
      style={`background: linear-gradient(76.97deg, #121B2E 18.79%, rgba(22, 32, 50, 0) 83.76%), linear-gradient(40.96deg, #121B2E 20%, rgba(22, 32, 50, 0) 100%), url('${backgroundImage}'); background-repeat: no-repeat; background-position: center center; background-size: cover;`}
    >
    </div>
  </div>
  <div class="relative z-20 w-full max-w-7xl mx-auto py-24">
    <div class="max-w-2xl px-12 pt-4 text-center md:text-left mx-auto md:mx-0">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-8">
        {title}
      </h1>

      <p
        class="text-lg md:text-2xl text-slate-400 mb-12 max-w-xl mx-auto md:mx-0"
      >
        {subtitle}
      </p>

      <div class="flex flex-col md:flex-row flex-wrap gap-4 items-center">
        <a
          href={ctaLink}
          class="flex items-center justify-center h-12 px-6 w-full md:w-auto bg-blue-600 hover:bg-blue-500 text-white font-semibold text-lg rounded-lg transition-colors"
        >
          {ctaText}
        </a>
        <a
          href={secondaryCtaLink}
          class="flex items-center justify-center h-12 px-6 w-full md:w-auto border border-slate-600 backdrop-blur-xl text-slate-200 hover:text-white hover:border-slate-500 font-semibold text-lg rounded-lg transition-colors"
        >
          {secondaryCtaText}
        </a>
      </div>
    </div>
  </div>

  <div class="absolute bottom-8 left-0 right-0 flex justify-center">
    <a
      href="#features"
      class="animate-bounce text-slate-400 hover:text-slate-300 transition-colors"
    >
      <div class="w-12 h-12 flex items-center justify-center">
        <i class="ph ph-bold ph-mouse-simple text-2xl"></i>
      </div>
    </a>
  </div>
</header>

---
interface Props {
  title: string;
  subtitle: string;
  ctaText: string;
  ctaLink: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
  screenshot1?: string;
  screenshot2?: string;
}

const {
  title,
  subtitle,
  ctaText,
  ctaLink,
  secondaryCtaText = "Découvrir le jeu",
  secondaryCtaLink = "#features",
} = Astro.props;
---

<header
  class="overflow-hidden relative bg-[#0B1120] min-h-[100dvh] flex items-center"
  style="background-image: url('/bg.svg'); background-repeat: no-repeat; background-position: center right; background-size: cover;"
>
  <div class="relative z-20 w-full max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-24">
    <div class="max-w-2xl">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
        {title}
      </h1>

      <p class="text-lg md:text-xl text-slate-400 mb-10 leading-relaxed max-w-xl">
        {subtitle}
      </p>

      <div class="flex flex-wrap gap-4 items-center">
        <a
          href={ctaLink}
          class="bg-blue-500 hover:bg-blue-600 text-white font-medium py-3 px-8 rounded-md transition-all duration-300 text-base sm:text-lg"
        >
          {ctaText}
        </a>
        <a
          class="px-6 py-3 whitespace-nowrap border border-slate-600 backdrop-blur-xl text-slate-200 rounded-md font-medium hover:border-slate-400 transition-colors"
          href={secondaryCtaLink}
        >
          {secondaryCtaText}
        </a>
      </div>
    </div>
  </div>

  <div class="absolute bottom-8 left-0 right-0 flex justify-center">
    <a
      href="#features"
      class="animate-bounce text-slate-400 hover:text-blue-300 transition-colors"
    >
      <div class="border border-slate-500/50 rounded-full w-10 h-10 flex items-center justify-center">
        <i class="ph ph-mouse text-2xl"></i>
      </div>
    </a>
  </div>
</header>

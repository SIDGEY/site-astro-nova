---
interface Props {
  title: string;
  subtitle: string;
  ctaText: string;
  ctaLink: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
  screenshot1?: string;
  screenshot2?: string;
}

const {
  title,
  subtitle,
  ctaText,
  ctaLink,
  secondaryCtaText = "En savoir plus",
  secondaryCtaLink = "#features",
  screenshot1 = "/landing/screenshot1.jpg",
  screenshot2 = "/landing/screenshot2.jpg",
} = Astro.props;

import DiagonalDivider from "../DiagonalDivider.astro";
---

<header
  class="overflow-hidden relative  bg-slate-900 py-32 sm:py-24 px-12 md:px-6 min-h-[100dvh] md:min-h-[96dvh] flex items-center"
>
  <div class="max-w-3xl mx-auto relative z-20 w-full">
    <div class="grid md:grid-cols-1 gap-8 items-center">
      <!-- Colonne de gauche avec le texte -->
      <div
        class="flex flex-col items-center md:items-center text-center md:text-left z-10 "
      >
        <h1
          class="text-4xl md:text-4xl lg:text-5xl font-bold mb-6 sm:mb-8 text-slate-50 text-center"
        >
          {title}
        </h1>

        <p class="text-lg sm:text-xl md:text-xl text-slate-400 mb-6 sm:mb-8 text-center">
          {subtitle}
        </p>

        <div class="flex flex-row gap-4  items-center ">
          <a
              href={ctaLink}
              class="bg-blue-500 hover:bg-blue-600 text-white font-medium py-3 px-6 sm:px-8 rounded-md transition-all duration-300 flex items-center justify-center text-base sm:text-lg w-full md:w-auto"
          >
            {ctaText}
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-24 left-0 right-0 flex justify-center">
    <a
      href="#features"
      class="animate-bounce text-slate-400 hover:text-blue-300 transition-colors"
    >
      <div class="border border-slate-500/50 rounded-full w-10 h-10 flex items-center justify-center">
        <i class="ph ph-arrow-down text-2xl transform font-bold"></i>
      </div>
    </a>
  </div>
</header>

<!-- Divider -->
<DiagonalDivider
  direction="bottom-right"
  color="text-slate-900"
  negativeMarginTop="-mt-24"
  zIndex={20}
/>

<style>
  /* Les animations floatUp et floatDown sont maintenant définies dans global.css */
</style>

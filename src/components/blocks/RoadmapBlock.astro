---
interface Card {
  icon?: string;
  title: string;
  description?: string;
}

interface Entry {
  month: string;
  side?: "left" | "right";
  current?: boolean;
  cards: Card[];
}

interface Group {
  year: string;
  entries: Entry[];
}

interface Props {
  title: string;
  subtitle?: string;
  sectionId?: string;
  groups: Group[];
}

const { title, subtitle, sectionId, groups = [] } = Astro.props;

const DEFAULT_ICON = "ph-shield-star";
---

<section id={sectionId} class="roadmap bg-[#0F172B] text-slate-100">
  <!-- Hero header (same base as the other pages) -->
  <div class="bg-[#1d293d] relative flex flex-col items-center w-full pt-20">
    <div
      class="absolute bg-gradient-to-b from-[#0f172b] h-72 left-0 right-0 to-[#1d293d] top-0 pointer-events-none"
    >
    </div>
    <div
      class="relative z-10 px-6 md:px-12 lg:px-36 py-12 md:py-24 w-full max-w-[1440px] flex items-center justify-center"
    >
      <div class="flex flex-col gap-6 items-center w-full text-center">
        <h1
          class="text-4xl md:text-5xl lg:text-[60px] font-bold text-slate-50 leading-tight md:leading-[1.1]"
        >
          {title}
        </h1>
        {
          subtitle && (
            <p class="text-lg md:text-2xl text-[#90a1b9] font-normal leading-[1.3] max-w-2xl">
              {subtitle}
            </p>
          )
        }
      </div>
    </div>
  </div>

  <!-- Diagonal separator (same base as the other pages) -->
  <div class="relative w-full h-12 md:h-24 shrink-0">
    <svg
      class="absolute inset-0 w-full h-full"
      fill="none"
      preserveAspectRatio="none"
      viewBox="0 0 1440 96"
    >
      <rect width="1440" height="96" fill="#1D293D"></rect>
      <path d="M0 0L1440 96V96H0V0Z" fill="#0F172B"></path>
    </svg>
  </div>

  <!-- Timeline (same content-zone padding as the blog list page) -->
  <div class="bg-[#0F172B] px-6 md:px-12 lg:px-20 py-20 md:py-[128px]">
    <div id="roadmap-track" class="roadmap-track relative max-w-7xl mx-auto">
      {/* Continuous rail (left on mobile, centered on desktop) */}
      <div
        class="block absolute left-3 md:left-1/2 top-0 bottom-0 w-px -translate-x-1/2 bg-[#1D293D] z-0"
        aria-hidden="true"
      >
      </div>
      {/* Scroll-driven blue progress fill (desktop) */}
      {/* Solid mask behind the ship so the grey rail never shows between the
          blue trail and the icon. */}
      <div
        class="roadmap-ship-mask block absolute left-3 md:left-1/2 top-0 z-[1] w-3 h-10 bg-[#0F172B]"
        style="transform: translate(-50%, calc(var(--rm-progress, 0px) - 100% + 8px));"
        aria-hidden="true"
      >
      </div>
      <div
        class="roadmap-progress block absolute left-3 md:left-1/2 h-[192px] w-[2px] -translate-x-1/2 z-[2]"
        style="top: calc(var(--rm-progress, 0px) - 10px - 192px); background: linear-gradient(to top, #51A2FF 0%, #155DFC 25%, #155DFC 50%, rgba(21,93,252,0) 100%); border-radius: 2px;"
        aria-hidden="true"
      >
      </div>
      {/* The "ship" travelling at the head of the progress line */}
      <div
        class="roadmap-ship flex absolute left-3 md:left-1/2 top-0 z-[5] w-4 h-4 items-center justify-center"
        style="transform: translate(-50%, calc(var(--rm-progress, 0px) - 50%));"
        aria-hidden="true"
      >
        <i
          class="ph-fill ph-paper-plane-right text-white text-base rotate-90 leading-none"
        >
        </i>
      </div>
      {/* Top fade so the rail emerges smoothly at the start of the timeline */}
      <div
        class="block absolute inset-x-0 top-0 h-64 z-[3] pointer-events-none"
        style="background: linear-gradient(to top, rgba(15,23,43,0) 0%, #0F172B 100%);"
        aria-hidden="true"
      >
      </div>
      {/* Start overlay (desktop only): smooths the blue trail emergence below the first badge.
          On mobile the trail's own gradient handles the fade. */}
      <div
        class="roadmap-start-overlay hidden md:block absolute left-1/2 w-12 -translate-x-1/2 z-[3] pointer-events-none"
        style="top: var(--rm-overlay-top, 0px); height: 150px; background: linear-gradient(to bottom, #0F172B 0%, #0F172B 12%, rgba(15,23,43,0) 100%);"
        aria-hidden="true"
      >
      </div>
      {/* Bottom fade so the rail melts into the background (end of timeline) */}
      <div
        class="block absolute inset-x-0 bottom-0 h-64 z-[3] pointer-events-none"
        style="background: linear-gradient(to bottom, rgba(15,23,43,0), #0F172B);"
        aria-hidden="true"
      >
      </div>

      {
        groups.map((group, gIdx) => (
          <div>
            {gIdx > 0 && (
              <div class="relative h-32" aria-hidden="true">
                {/* Year-end fade only on desktop; on mobile the rail stays continuous */}
                <div
                  class="hidden md:block absolute inset-0 z-[3] pointer-events-none"
                  style="background: linear-gradient(to bottom, rgba(15,23,43,0), #0F172B);"
                >
                </div>
              </div>
            )}
            {/* Year heading (masks the rail on desktop; left-aligned on mobile) */}
            <div class="relative z-[4] flex justify-start md:justify-center pl-10 md:pl-0 pb-1 md:bg-[#0F172B]">
              <span class="md:bg-[#0F172B] md:px-4 text-[#E2E8F0] font-bold text-4xl leading-10 text-left md:text-center">
                {group.year}
              </span>
            </div>

            {group.entries.map((entry) => (
              <div class="w-full">
                {/* Month badge centered on the line (its bg masks the rail) */}
                <div class="roadmap-badge relative z-[4] flex justify-start md:justify-center pl-10 md:pl-0 py-4 md:bg-[#0F172B]">
                  <span
                    class="inline-flex backdrop-blur-md px-3 py-1 rounded-full text-[#60A5FA] text-sm font-medium leading-5"
                    style="background: rgba(59,130,246,0.2);"
                  >
                    {entry.month}
                  </span>
                </div>

                {entry.cards.map((card) => (
                  <>
                    {/* Desktop row: two columns around the center line */}
                    <div class="hidden md:flex items-center w-full py-3 relative z-[4]">
                      <div class="flex-1 flex justify-end pr-8">
                        {entry.side !== "right" && (
                          <div class="roadmap-card card-with-border">
                            <i
                              class={`ph ${card.icon ?? DEFAULT_ICON} text-[32px] text-[#90A1B9] leading-none`}
                              aria-hidden="true"
                            />
                            <div class="flex flex-col gap-2 max-w-[320px]">
                              <p class="text-[#E2E8F0] font-bold text-lg leading-7 mb-0">
                                {card.title}
                              </p>
                              {card.description && (
                                <p class="text-[#90A1B9] text-sm leading-5 mb-0">
                                  {card.description}
                                </p>
                              )}
                            </div>
                          </div>
                        )}
                      </div>

                      {/* Center node */}
                      <div class="relative z-[2] w-px shrink-0 flex items-center justify-center">
                        <span
                          class="roadmap-dot absolute size-1.5 rounded-full"
                          style="background:#76859C; box-shadow:0 0 0 6px #0F172B;"
                        />
                      </div>

                      <div class="flex-1 flex justify-start pl-8">
                        {entry.side === "right" && (
                          <div class="roadmap-card card-with-border">
                            <i
                              class={`ph ${card.icon ?? DEFAULT_ICON} text-[32px] text-[#90A1B9] leading-none`}
                              aria-hidden="true"
                            />
                            <div class="flex flex-col gap-2 max-w-[320px]">
                              <p class="text-[#E2E8F0] font-bold text-lg leading-7 mb-0">
                                {card.title}
                              </p>
                              {card.description && (
                                <p class="text-[#90A1B9] text-sm leading-5 mb-0">
                                  {card.description}
                                </p>
                              )}
                            </div>
                          </div>
                        )}
                      </div>
                    </div>

                    {/* Mobile row: single column card to the right of the left rail */}
                    <div class="flex md:hidden w-full py-3 relative z-[4] pl-10">
                      <span
                        class="roadmap-dot absolute left-3 top-1/2 size-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full"
                        style="background:#76859C; box-shadow:0 0 0 6px #0F172B;"
                      />
                      <div class="flex-1">
                        <div class="roadmap-card card-with-border">
                          <i
                            class={`ph ${card.icon ?? DEFAULT_ICON} text-[32px] text-[#90A1B9] leading-none`}
                            aria-hidden="true"
                          />
                          <div class="flex flex-col gap-2 max-w-[320px]">
                            <p class="text-[#E2E8F0] font-bold text-lg leading-7 mb-0">
                              {card.title}
                            </p>
                            {card.description && (
                              <p class="text-[#90A1B9] text-sm leading-5 mb-0">
                                {card.description}
                              </p>
                            )}
                          </div>
                        </div>
                      </div>
                    </div>
                  </>
                ))}
              </div>
            ))}
          </div>
        ))
      }

      {/* Extra space added after the last card so the rail/fade extend beyond it */}
      <div class="block h-32 md:h-64" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .roadmap-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    max-width: 480px;
    padding: 24px 32px 32px;
    border-radius: 0.5rem;
    backdrop-filter: blur(2px);
    opacity: 0.8;
  }
</style>

<script>
  function initRoadmapTimeline() {
    const track = document.getElementById("roadmap-track");
    if (!track) return;

    const dots = Array.from(
      track.querySelectorAll<HTMLElement>(".roadmap-dot"),
    );
    const firstBadge = track.querySelector<HTMLElement>(".roadmap-badge");
    let ticking = false;

    function update() {
      ticking = false;
      const rect = track!.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight;

      // Only the dots visible at the current breakpoint count (desktop OR mobile).
      const visibleDots = dots.filter((d) => d.getClientRects().length > 0);

      // Positions (relative to the track) of the first and last node: the ship
      // is parked on the first node by default and stops on the last one.
      let firstPos = 0;
      let lastPos = rect.height;
      if (visibleDots.length) {
        const f = visibleDots[0].getBoundingClientRect();
        const l = visibleDots[visibleDots.length - 1].getBoundingClientRect();
        firstPos = f.top + f.height / 2 - rect.top;
        lastPos = l.top + l.height / 2 - rect.top;
      }

      // The head sticks to ~45% of the viewport. It only starts advancing once
      // the first node reaches that line, and freezes on the last node.
      // Anchor the start overlay just below the first month badge.
      if (firstBadge) {
        const b = firstBadge.getBoundingClientRect();
        track!.style.setProperty("--rm-overlay-top", b.bottom - rect.top + "px");
      }

      let head = vh * 0.45 - rect.top;
      if (head < firstPos) head = firstPos;
      if (head > lastPos) head = lastPos;
      track!.style.setProperty("--rm-progress", head + "px");

      // Light up the nodes the ship has already passed.
      for (const dot of visibleDots) {
        const d = dot.getBoundingClientRect();
        const pos = d.top + d.height / 2 - rect.top;
        dot.style.background = head >= pos ? "#FFFFFF" : "#76859C";
      }
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
  }

  initRoadmapTimeline();
  // Re-init after Astro view transitions / client navigation.
  document.addEventListener("astro:page-load", initRoadmapTimeline);
</script>

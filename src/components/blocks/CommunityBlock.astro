---
interface Props {
  title: string;
  subtitle: string;
  sectionTitle: string;
  description: string;
  secondaryDescription?: string;
  discordLink: string;
  discordButtonText?: string;
  image: string;
  imageAlt: string;
}

const {
  title,
  subtitle,
  sectionTitle,
  description,
  secondaryDescription,
  discordLink,
  discordButtonText = "Rejoindre le Discord",
  image,
  imageAlt,
} = Astro.props;
---

<section id="community" class="bg-[#0B1120] py-20 md:py-28 px-6">
  <div class="max-w-6xl mx-auto">
    <!-- Section Title -->
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-slate-100">
        {title}
      </h2>
      <p class="text-base md:text-lg text-slate-400 max-w-3xl mx-auto">{subtitle}</p>
    </div>

    <!-- Card -->
    <div class="grid md:grid-cols-2 gap-0 rounded-xl overflow-hidden border border-slate-700/50 bg-slate-900/30">
      <!-- Image Column -->
      <div class="h-64 md:h-auto">
        <img
          src={image}
          alt={imageAlt}
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Text Column -->
      <div class="p-8 md:p-12 flex flex-col justify-center">
        <h3 class="text-xl sm:text-2xl font-bold mb-4 text-slate-200">
          {sectionTitle}
        </h3>

        <p class="text-slate-400 mb-4 leading-relaxed text-sm md:text-base">
          {description}
        </p>

        {secondaryDescription && (
          <p class="text-slate-400 leading-relaxed mb-6 text-sm md:text-base">
            {secondaryDescription}
          </p>
        )}

        <div class="mt-2">
          <a
            href={discordLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 py-3 px-6 bg-blue-500 hover:bg-blue-600 rounded-md font-medium transition-colors text-white"
          >
            <i class="ph ph-discord-logo text-xl"></i>
            {discordButtonText}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

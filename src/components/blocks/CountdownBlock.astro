---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  targetDate: string;
  ctaText?: string;
  ctaLink?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
}

const {
  eyebrow = "Lancement officiel",
  title,
  subtitle,
  targetDate,
  ctaText,
  ctaLink,
  secondaryCtaText,
  secondaryCtaLink,
} = Astro.props;

const launchDate = new Date(targetDate);
const launchDateLabel = launchDate.toLocaleDateString("fr-FR", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "Europe/Paris",
});
const launchTimeLabel = launchDate
  .toLocaleTimeString("fr-FR", {
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
    timeZone: "Europe/Paris",
  })
  .replace(":", "h");
---

<section class="relative overflow-hidden bg-[#121B2E] py-20 md:py-28">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-blue-600/20 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-indigo-500/20 rounded-full blur-3xl"></div>
  </div>

  <div class="relative z-10 container-custom text-center">
    <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 text-blue-300 text-sm font-semibold uppercase tracking-widest mb-6">
      <i class="ph ph-bold ph-rocket-launch"></i>
      {eyebrow}
    </span>

    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4">
      {title}
    </h2>

    {subtitle && (
      <p class="text-lg md:text-xl text-slate-400 max-w-2xl mx-auto mb-4">
        {subtitle}
      </p>
    )}

    <p class="text-sm md:text-base text-slate-500 mb-10 capitalize">
      {launchDateLabel} à {launchTimeLabel} (heure de Paris)
    </p>

    <div class="flex justify-center gap-3 sm:gap-6 mb-12" data-countdown={targetDate}>
      <div class="countdown-tile">
        <span class="countdown-value" data-unit="days">00</span>
        <span class="countdown-label">Jours</span>
      </div>
      <div class="countdown-tile">
        <span class="countdown-value" data-unit="hours">00</span>
        <span class="countdown-label">Heures</span>
      </div>
      <div class="countdown-tile">
        <span class="countdown-value" data-unit="minutes">00</span>
        <span class="countdown-label">Min</span>
      </div>
      <div class="countdown-tile">
        <span class="countdown-value" data-unit="seconds">00</span>
        <span class="countdown-label">Sec</span>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row justify-center gap-4">
      {ctaText && ctaLink && (
        <a
          href={ctaLink}
          class="flex items-center justify-center h-12 px-8 w-full sm:w-auto bg-blue-600 hover:bg-blue-500 text-white font-semibold text-lg rounded-lg transition-colors"
        >
          {ctaText}
        </a>
      )}
      {secondaryCtaText && secondaryCtaLink && (
        <a
          href={secondaryCtaLink}
          class="flex items-center justify-center h-12 px-8 w-full sm:w-auto border border-slate-600 text-slate-200 hover:text-white hover:border-slate-500 font-semibold text-lg rounded-lg transition-colors"
        >
          {secondaryCtaText}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .countdown-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    width: 5rem;
    height: 5rem;
  }
  @media (min-width: 640px) {
    .countdown-tile {
      width: 7rem;
      height: 7rem;
    }
  }
  .countdown-value {
    font-size: 1.875rem;
    font-weight: 700;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 640px) {
    .countdown-value {
      font-size: 2.25rem;
    }
  }
  .countdown-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgb(148 163 184);
    margin-top: 0.25rem;
  }
  @media (min-width: 640px) {
    .countdown-label {
      font-size: 0.75rem;
    }
  }
</style>

<script>
  function initCountdowns() {
    document.querySelectorAll<HTMLElement>("[data-countdown]").forEach((el) => {
      if (el.dataset.countdownBound === "true") return;
      el.dataset.countdownBound = "true";

      const target = new Date(el.dataset.countdown!).getTime();
      const daysEl = el.querySelector<HTMLElement>('[data-unit="days"]');
      const hoursEl = el.querySelector<HTMLElement>('[data-unit="hours"]');
      const minutesEl = el.querySelector<HTMLElement>('[data-unit="minutes"]');
      const secondsEl = el.querySelector<HTMLElement>('[data-unit="seconds"]');

      let interval: ReturnType<typeof setInterval>;

      const tick = () => {
        const diff = Math.max(0, target - Date.now());
        const days = Math.floor(diff / 86400000);
        const hours = Math.floor((diff % 86400000) / 3600000);
        const minutes = Math.floor((diff % 3600000) / 60000);
        const seconds = Math.floor((diff % 60000) / 1000);

        if (daysEl) daysEl.textContent = String(days).padStart(2, "0");
        if (hoursEl) hoursEl.textContent = String(hours).padStart(2, "0");
        if (minutesEl) minutesEl.textContent = String(minutes).padStart(2, "0");
        if (secondsEl) secondsEl.textContent = String(seconds).padStart(2, "0");

        if (diff <= 0) clearInterval(interval);
      };

      tick();
      interval = setInterval(tick, 1000);
    });
  }

  initCountdowns();
  document.addEventListener("astro:page-load", initCountdowns);
</script>

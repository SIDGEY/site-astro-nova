---
interface NewsItem {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  title: string;
  subtitle: string;
  items: NewsItem[];
}

const { title, subtitle, items = [] } = Astro.props;
---

<section
  class="relative bg-slate-900 pt-20 md:pt-[128px] px-6 md:px-12 lg:px-20 flex items-center"
>
  <div
    class="relative z-[2] max-w-7xl mx-auto w-full grid items-center"
  >
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-50 mb-4">
        {title}
      </h2>
      <p class="text-base md:text-xl text-slate-400 mb-0 max-w-2xl mx-auto">
        {subtitle}
      </p>
    </div>

    <div
      class="news-track flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth scrollbar-hide -mx-6 px-6 sm:mx-0 sm:px-0 sm:gap-6 sm:overflow-visible sm:grid sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        items.map((item) => (
          <div class="news-card card-with-border group flex-shrink-0 w-[87%] snap-center sm:w-auto rounded-xl overflow-hidden transition-colors">
            <div class="aspect-[5/3] rounded-xl w-full flex shrink-0 items-center justify-center overflow-hidden border bg-slate-800 border-slate-700/50 transition-colors">
              <div class="relative w-full h-full flex items-center justify-center overflow-hidden">
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                  <div
                    class="absolute rounded-full"
                    style="width:400px;height:400px;padding:1px;opacity:0.2;background:linear-gradient(to bottom, #334155, #1e293b);-webkit-mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);-webkit-mask-composite:destination-out;mask-composite:exclude"
                  />
                  <div
                    class="absolute rounded-full"
                    style="width:300px;height:300px;padding:1px;opacity:0.4;background:linear-gradient(to bottom, #334155, #1e293b);-webkit-mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);-webkit-mask-composite:destination-out;mask-composite:exclude"
                  />
                  <div
                    class="absolute rounded-full"
                    style="width:225px;height:225px;padding:1px;opacity:0.6;background:linear-gradient(to bottom, #334155, #1e293b);-webkit-mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);-webkit-mask-composite:destination-out;mask-composite:exclude"
                  />
                  <div
                    class="absolute rounded-full"
                    style="width:150px;height:150px;padding:1px;opacity:0.8;background:linear-gradient(to bottom, #334155, #1e293b);-webkit-mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);-webkit-mask-composite:destination-out;mask-composite:exclude"
                  />
                </div>
                <div class="relative z-10">
                  <svg
                    width="58"
                    height="64"
                    viewBox="0 0 58 64"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M57.6 44.2556L57.2486 44.2333C52.4991 43.6195 47.702 43.157 42.8625 42.8514L28.8 64L14.7375 42.8514C9.89795 43.157 5.10092 43.6195 0.351389 44.2333L0 44.2556L28.8 0L57.6 44.2556ZM17.3736 34.975L22.6486 37.5917L28.8 46.8417L34.9514 37.5917L40.225 34.975L28.8 17.4167L17.3736 34.975Z"
                      fill="#314158"
                    />
                  </svg>
                </div>
              </div>
            </div>
            <div class="px-8 pt-6 pb-8">
              <h3 class="text-xl font-semibold text-slate-100 mb-3">
                {item.title}
              </h3>
              <p class="text-base text-slate-400 leading-relaxed mb-0">
                {item.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Dots (mobile only) -->
    <div
      class="news-dots flex sm:hidden justify-center gap-0 my-12 overflow-hidden"
    >
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".news-track").forEach((track) => {
    const section = track.closest("section");
    const dotsContainer = section?.querySelector<HTMLElement>(".news-dots");
    const cards = Array.from(
      track.querySelectorAll<HTMLElement>(".news-card"),
    );

    if (!cards.length || !dotsContainer) return;

    let currentPage = 0;
    let dots: HTMLButtonElement[] = [];

    // Instagram-style sliding window (same constants as CarouselBlock)
    const WIN = 5;
    const DOT_PX = [6, 5, 4];
    const DOT_OPACITY = [1, 0.4, 0.2];
    const DOT_COLOR = "rgb(226,232,240)";

    function winStart(page: number, total: number): number {
      const w = Math.min(WIN, total);
      return Math.max(0, Math.min(page - Math.floor(w / 2), total - w));
    }

    function applyDots(page: number) {
      const total = dots.length;
      const ws = winStart(page, total);
      const we = ws + Math.min(WIN, total);

      dots.forEach((btn, i) => {
        const dot = btn.querySelector<HTMLSpanElement>("span")!;
        const inWin = i >= ws && i < we;
        const dist = Math.abs(i - page);

        if (!inWin) {
          btn.style.width = "0";
          btn.style.padding = "0";
        } else {
          const idx = Math.min(dist, DOT_PX.length - 1);
          btn.style.width = "";
          btn.style.padding = "4px";
          dot.style.width = DOT_PX[idx] + "px";
          dot.style.height = DOT_PX[idx] + "px";
          dot.style.backgroundColor = DOT_COLOR;
          dot.style.opacity = String(DOT_OPACITY[idx]);
          dot.style.boxShadow = idx === 0 ? `0 0 0 2px ${DOT_COLOR}` : "";
        }
      });
    }

    function nearestPage(): number {
      if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 2) {
        return cards.length - 1;
      }
      if (track.scrollLeft <= 2) {
        return 0;
      }
      const center = track.scrollLeft + track.clientWidth / 2;
      let closest = 0;
      let minDist = Infinity;
      cards.forEach((card, i) => {
        const dist = Math.abs(card.offsetLeft + card.clientWidth / 2 - center);
        if (dist < minDist) {
          minDist = dist;
          closest = i;
        }
      });
      return closest;
    }

    function goToPage(page: number) {
      currentPage = page;
      applyDots(page);
      const card = cards[page];
      const offset =
        card.offsetLeft - (track.clientWidth - card.clientWidth) / 2;
      track.scrollTo({ left: Math.max(0, offset), behavior: "smooth" });
    }

    function buildDots() {
      dotsContainer!.innerHTML = "";
      dots = cards.map((_, i) => {
        const btn = document.createElement("button");
        btn.style.cssText =
          "display:flex;align-items:center;justify-content:center;" +
          "cursor:pointer;transition:width 300ms ease,padding 300ms ease;overflow:hidden;";
        btn.setAttribute("aria-label", `Page ${i + 1}`);

        const dot = document.createElement("span");
        dot.style.cssText =
          "display:block;border-radius:9999px;" +
          "transition:width 300ms ease,height 300ms ease,background-color 300ms ease,box-shadow 300ms ease;";

        btn.appendChild(dot);
        btn.addEventListener("click", () => goToPage(i));
        dotsContainer!.appendChild(btn);
        return btn;
      });
      applyDots(currentPage);
    }

    track.addEventListener(
      "scroll",
      () => {
        const page = nearestPage();
        if (page !== currentPage) {
          currentPage = page;
          applyDots(page);
        }
      },
      { passive: true },
    );

    buildDots();
  });
</script>

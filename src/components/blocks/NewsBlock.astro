---
interface NewsItem {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  title: string;
  subtitle: string;
  items: NewsItem[];
}

const { title, subtitle, items = [] } = Astro.props;
---

<section class="bg-[#0B1120] py-20 md:py-28 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-5xl font-bold text-slate-50 mb-4">
        {title}
      </h2>
      <p class="text-base md:text-lg text-slate-400 max-w-2xl mx-auto">
        {subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {items.map((item) => (
        <div class="rounded-xl border border-slate-700/50 bg-slate-900/30 overflow-hidden hover:border-slate-600 transition-colors">
          <div class="aspect-[4/3] bg-slate-800/50 flex items-center justify-center">
            <i class={`ph ph-${item.icon} text-5xl text-slate-600`}></i>
          </div>
          <div class="p-6">
            <h3 class="text-lg font-bold text-slate-100 mb-2">{item.title}</h3>
            <p class="text-sm text-slate-400 leading-relaxed">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

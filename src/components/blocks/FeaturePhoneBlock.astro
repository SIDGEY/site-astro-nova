---
import Mobile from "../Mobile.astro";

interface GalleryImage {
  src: string;
  alt?: string;
}

interface Props {
  icon: string;
  title: string;
  subtitle: string;
  screenshot1: string;
  screenshot2: string;
  backgroundImage?: string;
  reversed?: boolean;
  gallery?: GalleryImage[];
  galleryExtra?: number;
  resourceIcons?: { icon: string; active?: boolean; screenshot?: string }[];
}

const {
  icon,
  title,
  subtitle,
  screenshot1,
  screenshot2,
  backgroundImage,
  reversed = false,
  gallery = [],
  galleryExtra = 0,
  resourceIcons = [],
} = Astro.props;

// Generate a unique ID for this section instance
const sectionId = `feature-phone-${Math.random().toString(36).slice(2, 9)}`;

// Determine which phone is active (the one whose screenshot changes)
// Normal: Phone1 = context (center, col-span-2), Phone2 = active (far, col-span-1)
// Reversed: Phone1 = active (far, col-span-1), Phone2 = context (center, col-span-2)
// The "context" phone is always the larger one (col-span-2)
// The "active" phone is always the smaller one (col-span-1)
---

<section
  class={`feature-phone-section overflow-hidden relative bg-[#0B1120] py-20 md:py-[128px] px-6 md:px-12 lg:px-20 flex items-center ${reversed ? 'is-reversed' : ''}`}
  id={sectionId}
  data-reversed={reversed.toString()}
>
  <!-- Background image layers -->
  {backgroundImage && (
    <div class="absolute inset-0 z-[0] pointer-events-none w-full h-full bg-[#121B2E]">
      <!-- Image 75% width & its overlays -->
      <div
        class={`absolute opacity-80 top-0 bottom-0 w-[75%] ${reversed ? 'right-0 left-auto' : 'left-0 right-auto'}`}
        style={`background: linear-gradient(${reversed ? '76.97deg' : '283.03deg'}, #121B2E 18.79%, rgba(22, 32, 50, 0) 83.76%), linear-gradient(${reversed ? '40.96deg' : '319.04deg'}, #121B2E 20%, rgba(22, 32, 50, 0) 100%), url('${backgroundImage}'); background-repeat: no-repeat; background-position: center center; background-size: cover;`}
      ></div>

      <!-- Global Overlay 100% width -->
      <div
        class="absolute inset-0 w-full h-full"
        style={`background: linear-gradient(360deg, rgba(2, 6, 24, 0.5) 0%, rgba(22, 32, 50, 0) 100.04%), linear-gradient(${reversed ? '63.33deg' : '296.67deg'}, #020618 0%, rgba(22, 32, 50, 0) 66.72%);`}
      ></div>
    </div>
  )}

  <!-- Desktop layout: 3-column grid [1fr 232px 1fr] so center phone is always perfectly aligned -->
  <div
    class="relative z-[2] max-w-7xl mx-auto w-full hidden sm:grid items-center"
    style="grid-template-columns: 1fr 232px 1fr; column-gap: 32px;"
  >
    <!-- Left column -->
    <div
      class={`flex items-center ${
        reversed
          ? "justify-start order-1"
          : "justify-end order-1"
      }`}
    >
      {reversed ? (
        <!-- Reversed: text on the left -->
        <div class="flex flex-col items-start text-left z-10 pr-4 pl-12">
          <i
            class={`ph ph-regular ph-${icon} mb-6 opacity-80`}
            style="font-size: 48px; background: linear-gradient(180deg, #90A1B9 0%, rgba(248, 250, 252, 0.2) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
          ></i>
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-6 text-slate-50">
            {title}
          </h2>
          <p class="text-base md:text-lg text-slate-400 mb-16 leading-relaxed">
            {subtitle}
          </p>
          {
            resourceIcons.length > 0 && (
              <div class="flex mb-6" data-resource-buttons>
                {resourceIcons.map((ri, index) => (
                  <button
                    class={`resource-btn w-14 h-14 rounded-lg flex items-center justify-center transition-all hover:-translate-y-0.5 hover:opacity-80 ${
                      ri.active
                        ? "border-2 border-blue-500 bg-slate-900 text-slate-50"
                        : "opacity-50 text-slate-400"
                    }`}
                    data-index={index}
                    data-screenshot={ri.screenshot || ""}
                    data-active={ri.active ? "true" : "false"}
                  >
                    <i class={`ph ph-fill ph-${ri.icon} text-2xl`} />
                  </button>
                ))}
              </div>
            )
          }
          {
            gallery.length > 0 && (
              <div class="flex gap-3 h-[68px] items-center" data-gallery-buttons>
                {gallery.map((img, i) => (
                  <button
                    class={`gallery-btn relative w-auto aspect-[4/5] h-16 rounded-md transition-all hover:opacity-60 ${
                      i === 0 ? "" : "opacity-40"
                    }`}
                    style="background: radial-gradient(100% 145.8% at 100% 0%, rgba(30, 41, 59, 0.5) 0%, rgba(30, 41, 59, 0.1) 100%); backdrop-filter: blur(1px);"
                    data-index={i}
                    data-screenshot={img.src}
                    data-active={i === 0 ? "true" : "false"}
                  >
                    <img
                      src={img.src}
                      alt={img.alt || ""}
                      class="w-full h-full object-cover"
                    />
                    {/* Gradient overlay - from game */}
                    <div
                      class="absolute inset-0 pointer-events-none"
                      style="background: linear-gradient(135.33deg, rgba(42, 48, 60, 0.66) 4.02%, rgba(42, 48, 60, 0) 50%), linear-gradient(135deg, rgba(67, 76, 96, 0) 50%, rgba(67, 76, 96, 0.33) 75%, #434C60 100%);"
                    ></div>
                    {/* Border overlay for inactive */}
                    <div class="absolute inset-0 border-2 border-slate-900 rounded-sm pointer-events-none"></div>
                    {/* Active border overlay - outside using outline */}
                    <div
                      class={`gallery-active-overlay absolute -inset-[2px] border-2 border-blue-500 rounded-md pointer-events-none transition-opacity ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
                    ></div>
                  </button>
                ))}
                {galleryExtra > 0 && (
                  <div class="w-14 h-16 rounded-md border border-slate-800 flex items-center justify-center text-slate-500 text-base font-medium bg-slate-900/50">
                    +{galleryExtra}
                  </div>
                )}
              </div>
            )
          }
        </div>
      ) : (
        <!-- Normal: active phone on the left -->
        <div class="relative z-0">
          <Mobile
            screenshot={gallery.length > 0 ? gallery[0].src : screenshot2}
            dataRole="active-phone"
          />
        </div>
      )}
    </div>

    <!-- Center column: context phone (always 232px, always centered) -->
    <div class="relative z-10 order-2 flex justify-center">
      <Mobile
        screenshot={screenshot1}
        dataRole="context-phone"
      />
    </div>

    <!-- Right column -->
    <div
      class={`flex items-center ${
        reversed
          ? "justify-start order-3"
          : "justify-start order-3"
      }`}
    >
      {reversed ? (
        <!-- Reversed: active phone on the right -->
        <div class="relative z-0">
          <Mobile
            screenshot={gallery.length > 0 ? gallery[0].src : screenshot2}
            dataRole="active-phone"
          />
        </div>
      ) : (
        <!-- Normal: text on the right -->
        <div class="flex flex-col items-start text-left z-10 pl-4 pr-12">
          <i
            class={`ph ph-regular ph-${icon} mb-6 opacity-80`}
            style="font-size: 48px; background: linear-gradient(180deg, #90A1B9 0%, rgba(248, 250, 252, 0.2) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
          ></i>
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-6 text-slate-50">
            {title}
          </h2>
          <p class="text-base md:text-lg text-slate-400 mb-16 leading-relaxed">
            {subtitle}
          </p>
          {
            resourceIcons.length > 0 && (
              <div class="flex mb-6" data-resource-buttons>
                {resourceIcons.map((ri, index) => (
                  <button
                    class={`resource-btn w-14 h-14 rounded-lg flex items-center justify-center transition-all hover:-translate-y-0.5 hover:opacity-80 ${
                      ri.active
                        ? "border-2 border-blue-500 bg-slate-900 text-slate-50"
                        : "opacity-50 text-slate-400"
                    }`}
                    data-index={index}
                    data-screenshot={ri.screenshot || ""}
                    data-active={ri.active ? "true" : "false"}
                  >
                    <i class={`ph ph-fill ph-${ri.icon} text-2xl`} />
                  </button>
                ))}
              </div>
            )
          }
          {
            gallery.length > 0 && (
              <div class="flex gap-3 h-[68px] items-center" data-gallery-buttons>
                {gallery.map((img, i) => (
                  <button
                    class={`gallery-btn relative w-auto aspect-[4/5] h-16 rounded-md transition-all hover:opacity-60 ${
                      i === 0 ? "" : "opacity-40"
                    }`}
                    style="background: radial-gradient(100% 145.8% at 100% 0%, rgba(30, 41, 59, 0.5) 0%, rgba(30, 41, 59, 0.1) 100%); backdrop-filter: blur(1px);"
                    data-index={i}
                    data-screenshot={img.src}
                    data-active={i === 0 ? "true" : "false"}
                  >
                    <img
                      src={img.src}
                      alt={img.alt || ""}
                      class="w-full h-full object-cover"
                    />
                    {/* Gradient overlay - from game */}
                    <div
                      class="absolute inset-0 pointer-events-none"
                      style="background: linear-gradient(135.33deg, rgba(42, 48, 60, 0.66) 4.02%, rgba(42, 48, 60, 0) 50%), linear-gradient(135deg, rgba(67, 76, 96, 0) 50%, rgba(67, 76, 96, 0.33) 75%, #434C60 100%);"
                    ></div>
                    {/* Border overlay for inactive */}
                    <div class="absolute inset-0 border-2 border-slate-900 rounded-sm pointer-events-none"></div>
                    {/* Active border overlay - outside */}
                    <div
                      class={`gallery-active-overlay absolute -inset-[2px] border-2 border-blue-500 rounded-md pointer-events-none transition-opacity ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
                    ></div>
                  </button>
                ))}
                {galleryExtra > 0 && (
                  <div class="w-14 h-16 rounded-md border border-slate-800 flex items-center justify-center text-slate-500 text-base font-medium bg-slate-900/50">
                    +{galleryExtra}
                  </div>
                )}
              </div>
            )
          }
        </div>
      )}
    </div>
  </div>

  <!-- Mobile layout: phones stacked horizontally -->
  <div class="flex sm:hidden justify-center items-center gap-4 relative z-[2]">
    <div class="relative z-10">
      <Mobile
        screenshot={screenshot1}
        dataRole={reversed ? "active-phone-mobile" : "context-phone-mobile"}
      />
    </div>

    <!-- Mobile: floating gallery thumbnails -->
    {
      gallery.length > 0 && (
        <div class="absolute -bottom-4 left-0 right-0 flex gap-2 justify-center">
          {gallery.slice(0, 2).map((img, i) => (
            <div
              class={`w-20 h-20 rounded-xl overflow-hidden border-2 shadow-lg ${
                i === 0 ? "border-blue-500" : "border-slate-700/50"
              }`}
            >
              <img
                src={img.src}
                alt={img.alt || ""}
                class="w-full h-full object-cover"
              />
            </div>
          ))}
        </div>
      )
    }

    <!-- Mobile: floating resource icons -->
    {
      resourceIcons.length > 0 && (
        <div class="absolute -bottom-4 left-4 right-4 flex gap-3 justify-center">
          {resourceIcons.slice(0, 2).map((ri) => (
            <div class="w-20 h-20 rounded-xl border-2 border-slate-700/50 bg-slate-900/80 backdrop-blur-sm flex items-center justify-center shadow-lg">
              <i class={`ph ph-fill ph-${ri.icon} text-3xl text-slate-300`} />
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>

<script define:vars={{ sectionId }}>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById(sectionId);
    if (!section) return;

    const buttons = section.querySelectorAll('.resource-btn[data-screenshot]');
    const galleryButtons = section.querySelectorAll('.gallery-btn[data-screenshot]');
    if (buttons.length === 0 && galleryButtons.length === 0) return;

    // Find the active phone (the "far" one that should change)
    const activePhone = section.querySelector('[data-role="active-phone"]');
    const activePhoneMobile = section.querySelector('[data-role="active-phone-mobile"]');

    function updatePhoneScreenshot(screenshot) {
      if (!screenshot) return;
      // Find the screenshot img inside the active phone container
      if (activePhone) {
        const img = activePhone.querySelector('img[alt="Screenshot"]');
        if (img) {
          img.style.opacity = '0';
          img.style.transition = 'opacity 0.3s ease';
          setTimeout(() => {
            img.src = screenshot;
            img.style.opacity = '1';
          }, 150);
        }
      }
      if (activePhoneMobile) {
        const imgMobile = activePhoneMobile.querySelector('img[alt="Screenshot"]');
        if (imgMobile) {
          imgMobile.style.opacity = '0';
          imgMobile.style.transition = 'opacity 0.3s ease';
          setTimeout(() => {
            imgMobile.src = screenshot;
            imgMobile.style.opacity = '1';
          }, 150);
        }
      }
    }

    function setActiveButton(clickedBtn) {
      // Update resource button styles
      buttons.forEach((btn) => {
        btn.classList.remove('border-2', 'border-blue-500', 'bg-slate-900', 'text-slate-50');
        btn.classList.add('opacity-50', 'text-slate-400');
        btn.dataset.active = 'false';
      });

      clickedBtn.classList.remove('opacity-50', 'text-slate-400');
      clickedBtn.classList.add('border-2', 'border-blue-500', 'bg-slate-900', 'text-slate-50');
      clickedBtn.dataset.active = 'true';

      updatePhoneScreenshot(clickedBtn.dataset.screenshot);
    }

    function setActiveGalleryButton(clickedBtn) {
      // Get the parent container to only update buttons in the same group
      const container = clickedBtn.closest('[data-gallery-buttons]');
      if (!container) return;

      const groupButtons = container.querySelectorAll('.gallery-btn');
      groupButtons.forEach((btn) => {
        // Reset button opacity
        btn.classList.add('opacity-40');
        btn.dataset.active = 'false';
        // Hide overlay
        const overlay = btn.querySelector('.gallery-active-overlay');
        if (overlay) overlay.classList.add('opacity-0');
        if (overlay) overlay.classList.remove('opacity-100');
      });

      clickedBtn.classList.remove('opacity-40');
      clickedBtn.dataset.active = 'true';
      // Show overlay for active button
      const activeOverlay = clickedBtn.querySelector('.gallery-active-overlay');
      if (activeOverlay) activeOverlay.classList.remove('opacity-0');
      if (activeOverlay) activeOverlay.classList.add('opacity-100');

      updatePhoneScreenshot(clickedBtn.dataset.screenshot);
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        setActiveButton(btn);
      });
    });

    galleryButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        setActiveGalleryButton(btn);
      });
    });
  });
</script>

---
/**
 * Bloc « deux téléphones » de la home. Les écrans ne sont pas des captures : ce sont les écrans du
 * jeu reconstruits (`components/game/`), nourris par le catalogue synchronisé (`lib/game.ts`).
 * Le contenu ne nomme qu'une famille et des codes d'entités ; images, noms, descriptions et le
 * compteur « +N » en découlent.
 *
 * Le téléphone central (contexte) montre la page de la famille ; le téléphone secondaire (actif)
 * montre la fiche de l'entité choisie dans la galerie.
 */
import Mobile from "../Mobile.astro";
import FeatureScreens, { type FeatureFamily } from "../game/FeatureScreens.astro";
import { banners, gameFor, RESOURCE_ORDER, type GameEntity, type ResourceCode } from "../../lib/game";
import { localeFromPath } from "../../lib/i18n";

interface Props {
  icon: string;
  title: string;
  subtitle: string;
  family: FeatureFamily;
  items?: string[];
  backgroundImage?: string;
  reversed?: boolean;
  sectionId?: string;
}

const { icon, title, subtitle, family, items, backgroundImage, reversed = false, sectionId } = Astro.props;
const game = gameFor(localeFromPath(Astro.url.pathname));

const BANNER: Record<FeatureFamily, string> = {
  resources: "planet",
  buildings: "buildings",
  facilities: "facilities",
  defenses: "defense",
  ships: "ships",
  shop: "shop",
};
const background = backgroundImage ?? banners[BANNER[family]];

const isResources = family === "resources";
const isShop = family === "shop";
const resourceCodes = (items?.length ? items : [...RESOURCE_ORDER]) as ResourceCode[];
for (const code of resourceCodes) {
  if (isResources && !game.resources[code]) throw new Error(`Ressource inconnue « ${code} » (attendu : ${RESOURCE_ORDER.join(", ")})`);
}
const entities: GameEntity[] = isResources || isShop ? [] : game.pick(family, items?.length ? items : game.family(family).slice(0, 4).map((e) => e.code));
const galleryExtra = isResources || isShop ? 0 : Math.max(0, game.family(family).length - entities.length);

// Les deux vignettes flottantes du rendu mobile.
// Pour la boutique : deux avatars du catalogue, ceux que ses écrans mettent en vitrine.
const mobileCards = isShop
  ? game.avatars.filter((a) => a.rarity === "legendary").slice(0, 2)
  : isResources
    ? resourceCodes.slice(0, 2).map((code) => game.resources[code])
    : entities.slice(0, 2);

const instanceId = `feature-phone-${Math.random().toString(36).slice(2, 9)}`;
const screenItems = isResources ? resourceCodes : entities;
---

{sectionId && <span id={sectionId} style="display:block; height:0; overflow:hidden;"></span>}
<section
  class={`feature-phone-section overflow-hidden relative bg-[#0B1120] pt-20 pb-0 md:py-[128px] px-6 md:px-12 lg:px-20 flex items-center ${reversed ? 'is-reversed' : ''}`}
  id={instanceId}
  data-reversed={reversed.toString()}
>
  <!-- Background image layers -->
  {background && (
    <div class="absolute inset-0 z-[0] pointer-events-none w-full h-full bg-[#121B2E]">
      <!-- Image mobile: full width, vertical gradient -->
      <div
        class={`absolute sm:hidden opacity-40 top-0 bottom-0 w-full ${reversed ? 'right-0 left-auto' : 'left-0 right-auto'}`}
        style={`background: linear-gradient(0deg, #121B2E 40.01%, rgba(18, 27, 46, 0) 100.04%), url('${background}'); background-repeat: no-repeat; background-position: center center; background-size: cover;`}
      ></div>
      <!-- Image desktop: 75% width, angular gradients -->
      <div
        class={`absolute hidden sm:block opacity-80 top-0 bottom-0 w-[75%] ${reversed ? 'right-0 left-auto' : 'left-0 right-auto'}`}
        style={`background: linear-gradient(${reversed ? '76.97deg' : '283.03deg'}, #121B2E 18.79%, rgba(22, 32, 50, 0) 83.76%), linear-gradient(${reversed ? '40.96deg' : '319.04deg'}, #121B2E 20%, rgba(22, 32, 50, 0) 100%), url('${background}'); background-repeat: no-repeat; background-position: center center; background-size: cover;`}
      ></div>

      <!-- Global Overlay mobile -->
      <div
        class="absolute inset-0 w-full h-full sm:hidden"
        style="background: linear-gradient(17.94deg, #020618 -0.04%, rgba(22, 32, 50, 0) 100%);"
      ></div>
      <!-- Global Overlay desktop -->
      <div
        class="absolute inset-0 w-full h-full hidden sm:block"
        style={`background: linear-gradient(360deg, rgba(2, 6, 24, 0.5) 0%, rgba(22, 32, 50, 0) 100.04%), linear-gradient(${reversed ? '63.33deg' : '296.67deg'}, #020618 0%, rgba(22, 32, 50, 0) 66.72%);`}
      ></div>
    </div>
  )}

  <!-- Desktop layout (lg+): 3-column grid [1fr 232px 1fr] so center phone is always perfectly aligned.
       Normal: active phone | context phone | text. Reversed: text | context phone | active phone.
       Tablet (sm → lg): the side column is narrower than a phone and the active phone fell off the
       edge — only the active phone (the one the gallery drives) and the text remain, side by side. -->
  <div
    class={`relative z-[2] max-w-7xl mx-auto w-full hidden sm:grid items-center gap-x-12 lg:gap-x-8 ${reversed ? 'grid-cols-[1fr_232px]' : 'grid-cols-[232px_1fr]'} lg:grid-cols-[1fr_232px_1fr]`}
  >
    <!-- Active phone -->
    <div class={`flex items-center ${reversed ? 'justify-start order-3' : 'justify-end order-1'}`}>
      <div class="relative z-0">
        <Mobile dataRole="active-phone">
          <FeatureScreens role="active" family={family} items={screenItems} />
        </Mobile>
      </div>
    </div>

    <!-- Center column: context phone (always 232px, always centered) -->
    <div class="relative z-10 order-2 hidden lg:flex justify-center">
      <Mobile dataRole="context-phone">
        <FeatureScreens role="context" family={family} items={screenItems} />
      </Mobile>
    </div>

    <!-- Text -->
    <div class={`flex items-center ${reversed ? 'justify-start order-1' : 'justify-start order-3'}`}>
      <div class={`flex flex-col items-start text-left z-10 ${reversed ? 'pr-4 pl-12' : 'pl-4 pr-12'}`}>
        <i
          class={`ph ph-regular ph-${icon} mb-6 opacity-80`}
          style="font-size: 48px; background: linear-gradient(180deg, #90A1B9 0%, rgba(248, 250, 252, 0.2) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
        ></i>
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-6 text-slate-50">
          {title}
        </h2>
        <p class="text-base md:text-lg text-slate-400 mb-16 leading-relaxed">
          {subtitle}
        </p>
        {isResources && (
          <div class="relative flex gap-3 h-14 items-center mb-6" data-picker>
            <div
              data-picker-indicator
              class="absolute w-14 h-14 rounded-lg outline outline-2 outline-blue-500 outline-offset-2 pointer-events-none z-10 top-1/2 -translate-y-1/2 transition-[left] duration-300 ease-out"
              style="left: 0px;"
            ></div>
            {resourceCodes.map((code, index) => (
              <button
                type="button"
                class={`picker-btn w-14 h-14 rounded-lg flex items-center justify-center transition-all cursor-pointer hover:text-slate-50 text-slate-300 ${index === 0 ? "bg-slate-900" : "opacity-50"}`}
                data-index={index}
                data-active={index === 0 ? "true" : "false"}
                aria-label={game.resources[code].name}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                <i class={`ph ph-fill ph-${game.resources[code].icon} text-2xl`} />
              </button>
            ))}
          </div>
        )}
        {entities.length > 0 && (
          <div class="relative flex gap-3 h-[68px] items-center" data-picker>
            {/* Border indicator — moves via JS, sits outside overflow-hidden buttons */}
            <div
              data-picker-indicator
              class="absolute w-[51px] h-16 rounded-md outline outline-2 outline-blue-500 outline-offset-2 pointer-events-none z-10 top-1/2 -translate-y-1/2 transition-[left] duration-300 ease-out"
              style="left: 0px;"
            ></div>
            {entities.map((item, i) => (
              <button
                type="button"
                class={`picker-btn w-[51px] h-16 rounded-md overflow-hidden cursor-pointer transition-all duration-300 ${i === 0 ? "" : "opacity-50"}`}
                data-index={i}
                data-active={i === 0 ? "true" : "false"}
                aria-label={item.name}
                aria-pressed={i === 0 ? "true" : "false"}
              >
                <div class="relative w-full h-full">
                  <img
                    src={item.image}
                    alt=""
                    loading="lazy"
                    class={`w-full h-full object-cover transition-all duration-200 ${i === 0 ? "" : "grayscale"}`}
                  />
                  <div class="image-overlay"></div>
                  <div class="absolute inset-0 rounded-md border border-slate-600/50 pointer-events-none"></div>
                </div>
              </button>
            ))}
            {galleryExtra > 0 && (
              <div class="w-[51px] h-16 rounded-md overflow-hidden opacity-50 cursor-default transition-all duration-300">
                <div class="relative w-full h-full bg-slate-900/20 flex items-center justify-center">
                  <span class="text-slate-400 text-sm font-medium">+{galleryExtra}</span>
                  <div class="absolute inset-0 rounded-md border border-slate-700 pointer-events-none"></div>
                </div>
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Mobile layout: text above, media below -->
  <div class="flex sm:hidden flex-col items-center gap-10 relative z-[2] w-full">
    <!-- Text zone (centered) -->
    <div class="flex flex-col items-center text-center">
      <i
        class={`ph ph-regular ph-${icon} mb-5 opacity-80`}
        style="font-size: 48px; background: linear-gradient(180deg, #90A1B9 0%, rgba(248, 250, 252, 0.2) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
      ></i>
      <h2 class="text-2xl font-bold mb-3 text-slate-50">{title}</h2>
      <p class="text-base text-slate-400 leading-relaxed">{subtitle}</p>
    </div>

    <!-- Media zone: phone centered (3/4 of its height visible: aspect 232/360) with 2 floating cards -->
    <div class="relative w-full flex justify-center">
      <div class="relative w-[232px]">
        <div class="aspect-[232/360] overflow-hidden opacity-30 blur-[1px] relative z-10">
          <Mobile dataRole="context-phone-mobile">
            <FeatureScreens role="context" family={family} items={screenItems} />
          </Mobile>
        </div>

        {mobileCards.map((card, i) => (
          <div
            class={`absolute z-20 w-[104px] aspect-[4/5] flex items-center justify-center ${i === 0 ? 'left-2 -translate-x-1/2' : 'right-2 translate-x-1/2'}`}
            style={(i === 0) === reversed ? "top: 48px" : "top: calc(48px + 65px)"}
          >
            <div class={`float-${i + 1} w-full`}>
              <div class={`card-with-border relative w-full rounded-lg overflow-hidden shadow-2xl ${entities.length > 0 ? 'aspect-[4/5]' : 'aspect-square'}`}>
                <img src={card.image} alt={card.name} loading="lazy" class="w-full h-full object-cover" />
                <div class="image-overlay"></div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script define:vars={{ instanceId }}>
  function initFeaturePhone() {
    const section = document.getElementById(instanceId);
    if (!section || section.dataset.bound === 'true') return;
    section.dataset.bound = 'true';

    const picker = section.querySelector('[data-picker]');
    const stack = section.querySelector('[data-role="active-phone"] [data-screen-stack]');
    if (!picker || !stack) return;

    const indicator = picker.querySelector('[data-picker-indicator]');
    const buttons = picker.querySelectorAll('.picker-btn');
    const isGallery = picker.querySelector('img') !== null;

    function select(btn) {
      if (indicator) indicator.style.left = btn.offsetLeft + 'px';

      buttons.forEach((b) => {
        const on = b === btn;
        b.dataset.active = on ? 'true' : 'false';
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
        b.classList.toggle('opacity-50', !on);
        if (isGallery) b.querySelector('img')?.classList.toggle('grayscale', !on);
        else b.classList.toggle('bg-slate-900', on);
      });

      stack.querySelectorAll('[data-screen-index]').forEach((screen) => {
        screen.dataset.active = screen.dataset.screenIndex === btn.dataset.index ? 'true' : 'false';
      });
    }

    buttons.forEach((btn) => btn.addEventListener('click', () => select(btn)));
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initFeaturePhone);
  else initFeaturePhone();
</script>

<style is:global>
  @keyframes mobile-card-float {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-7px); }
  }

  .float-1 {
    animation: mobile-card-float 3.5s ease-in-out infinite;
  }

  .float-2 {
    animation: mobile-card-float 3.5s ease-in-out infinite 1.75s;
  }

  @media (prefers-reduced-motion: reduce) {
    .float-1, .float-2 { animation: none; }
  }
</style>

---
import Mobile from "../Mobile.astro";

interface GalleryImage {
  src: string;
  alt?: string;
}

interface Props {
  icon: string;
  title: string;
  subtitle: string;
  screenshot1: string;
  screenshot2: string;
  backgroundImage?: string;
  reversed?: boolean;
  gallery?: GalleryImage[];
  galleryExtra?: number;
  resourceIcons?: { icon: string; active?: boolean; screenshot?: string }[];
}

const {
  icon,
  title,
  subtitle,
  screenshot1,
  screenshot2,
  backgroundImage,
  reversed = false,
  gallery = [],
  galleryExtra = 0,
  resourceIcons = [],
} = Astro.props;

// Generate a unique ID for this section instance
const sectionId = `feature-phone-${Math.random().toString(36).slice(2, 9)}`;

// Determine which phone is active (the one whose screenshot changes)
// Normal: Phone1 = context (center, col-span-2), Phone2 = active (far, col-span-1)
// Reversed: Phone1 = active (far, col-span-1), Phone2 = context (center, col-span-2)
// The "context" phone is always the larger one (col-span-2)
// The "active" phone is always the smaller one (col-span-1)
---

<section
  class={`feature-phone-section overflow-hidden relative bg-[#0B1120] py-20 md:py-[120px] px-6 md:px-12 lg:px-20 flex items-center ${reversed ? 'is-reversed' : ''}`}
  id={sectionId}
  data-reversed={reversed.toString()}
>
  <!-- Background image layers -->
  {backgroundImage && (
    <div class="absolute inset-0 z-[0] pointer-events-none w-full h-full bg-[#121B2E]">
      <!-- Image 75% width & its overlays -->
      <div
        class={`absolute opacity-80 top-0 bottom-0 w-[75%] ${reversed ? 'right-0 left-auto' : 'left-0 right-auto'}`}
        style={`background: linear-gradient(${reversed ? '76.97deg' : '283.03deg'}, #121B2E 18.79%, rgba(22, 32, 50, 0) 83.76%), linear-gradient(${reversed ? '40.96deg' : '319.04deg'}, #121B2E 20%, rgba(22, 32, 50, 0) 100%), url('${backgroundImage}'); background-repeat: no-repeat; background-position: center center; background-size: cover;`}
      ></div>

      <!-- Global Overlay 100% width -->
      <div
        class="absolute inset-0 w-full h-full"
        style={`background: linear-gradient(360deg, rgba(2, 6, 24, 0.5) 0%, rgba(22, 32, 50, 0) 100.04%), linear-gradient(${reversed ? '63.33deg' : '296.67deg'}, #020618 0%, rgba(22, 32, 50, 0) 66.72%);`}
      ></div>
    </div>
  )}

  <div
    class="relative z-[2] max-w-7xl mx-auto w-full grid grid-cols-1 md:grid-cols-5 gap-12 items-center"
  >
    <!-- Phones side -->
    <div
      class={`hidden sm:flex items-center gap-8 relative md:col-span-3 ${
        reversed
          ? "md:order-2 justify-start"
          : "md:order-1 justify-end"
      }`}
    >
      <!-- Phone 1 (context phone = always closest to center) -->
      <div class={`relative z-10 ${reversed ? "order-1" : "order-2"}`}>
        <Mobile
          screenshot={screenshot1}
          dataRole="context-phone"
        />
      </div>

      <!-- Phone 2 (active phone = changes on button click, overflows into empty side) -->
      <div class={`relative z-0 ${reversed ? "order-2" : "order-1"}`}>
        <Mobile
          screenshot={screenshot2}
          dataRole="active-phone"
        />
      </div>
    </div>

    <!-- Mobile: both phones stacked horizontally -->
    <div class="flex sm:hidden justify-center items-center gap-4 relative">
      <div class="relative z-10">
        <Mobile
          screenshot={screenshot1}
          dataRole={reversed ? "active-phone-mobile" : "context-phone-mobile"}
        />
      </div>

      <!-- Mobile: floating gallery thumbnails -->
      {
        gallery.length > 0 && (
          <div class="absolute -bottom-4 left-0 right-0 flex gap-2 justify-center">
            {gallery.slice(0, 2).map((img, i) => (
              <div
                class={`w-20 h-20 rounded-xl overflow-hidden border-2 shadow-lg ${
                  i === 0 ? "border-blue-500" : "border-slate-700/50"
                }`}
              >
                <img
                  src={img.src}
                  alt={img.alt || ""}
                  class="w-full h-full object-cover"
                />
              </div>
            ))}
          </div>
        )
      }

      <!-- Mobile: floating resource icons -->
      {
        resourceIcons.length > 0 && (
          <div class="absolute -bottom-4 left-4 right-4 flex gap-3 justify-center">
            {resourceIcons.slice(0, 2).map((ri) => (
              <div class="w-20 h-20 rounded-xl border-2 border-slate-700/50 bg-slate-900/80 backdrop-blur-sm flex items-center justify-center shadow-lg">
                <i class={`ph ph-${ri.icon} text-3xl text-slate-300`} />
              </div>
            ))}
          </div>
        )
      }
    </div>

    <!-- Text side -->
    <div
      class={`flex flex-col items-center md:items-start text-center md:text-left z-10 md:col-span-2 ${
        reversed ? "md:pr-12 md:order-1" : "md:pl-12 md:order-3"
      }`}
    >
      <i
        class={`ph ph-${icon} mb-6`}
        style="font-size: 48px; background: linear-gradient(180deg, #90A1B9 0%, rgba(248, 250, 252, 0.2) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
      ></i>
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-6 text-slate-50">
        {title}
      </h2>
      <p class="text-base md:text-lg text-slate-400 mb-8 leading-relaxed">
        {subtitle}
      </p>

      {
        resourceIcons.length > 0 && (
          <div class="flex gap-3 mb-6" data-resource-buttons>
            {resourceIcons.map((ri, index) => (
              <button
                class={`resource-btn w-12 h-12 rounded-lg flex items-center justify-center transition-all ${
                  ri.active
                    ? "border-2 border-blue-500 bg-slate-900/80 text-white"
                    : "border border-slate-700 bg-slate-900/50 text-slate-400 hover:border-slate-500"
                }`}
                data-index={index}
                data-screenshot={ri.screenshot || ""}
                data-active={ri.active ? "true" : "false"}
              >
                <i class={`ph ph-${ri.icon} text-xl`} />
              </button>
            ))}
          </div>
        )
      }

      {
        gallery.length > 0 && (
          <div class="hidden md:flex gap-2 mt-2">
            {gallery.map((img, i) => (
              <div
                class={`w-14 h-14 rounded-lg overflow-hidden border ${
                  i === 0 ? "border-blue-500" : "border-slate-700/50"
                } ${i === 0 ? "" : "opacity-50"}`}
              >
                <img
                  src={img.src}
                  alt={img.alt || ""}
                  class="w-full h-full object-cover"
                />
              </div>
            ))}
            {galleryExtra > 0 && (
              <div class="w-14 h-14 rounded-lg border border-slate-700/50 flex items-center justify-center text-slate-400 text-sm bg-slate-900/50">
                +{galleryExtra}
              </div>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>

<script define:vars={{ sectionId }}>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById(sectionId);
    if (!section) return;

    const buttons = section.querySelectorAll('.resource-btn[data-screenshot]');
    if (buttons.length === 0) return;

    // Find the active phone (the "far" one that should change)
    const activePhone = section.querySelector('[data-role="active-phone"]');
    const activePhoneMobile = section.querySelector('[data-role="active-phone-mobile"]');

    function setActiveButton(clickedBtn) {
      // Update button styles
      buttons.forEach((btn) => {
        btn.classList.remove('border-2', 'border-blue-500', 'bg-slate-900/80', 'text-white');
        btn.classList.add('border', 'border-slate-700', 'bg-slate-900/50', 'text-slate-400');
        btn.dataset.active = 'false';
      });

      clickedBtn.classList.remove('border', 'border-slate-700', 'bg-slate-900/50', 'text-slate-400');
      clickedBtn.classList.add('border-2', 'border-blue-500', 'bg-slate-900/80', 'text-white');
      clickedBtn.dataset.active = 'true';

      // Update the active phone screenshot
      const screenshot = clickedBtn.dataset.screenshot;
      if (screenshot) {
        // Find the screenshot img inside the active phone container
        if (activePhone) {
          const img = activePhone.querySelector('img[alt="Screenshot"]');
          if (img) {
            img.style.opacity = '0';
            img.style.transition = 'opacity 0.3s ease';
            setTimeout(() => {
              img.src = screenshot;
              img.style.opacity = '1';
            }, 150);
          }
        }
        if (activePhoneMobile) {
          const imgMobile = activePhoneMobile.querySelector('img[alt="Screenshot"]');
          if (imgMobile) {
            imgMobile.style.opacity = '0';
            imgMobile.style.transition = 'opacity 0.3s ease';
            setTimeout(() => {
              imgMobile.src = screenshot;
              imgMobile.style.opacity = '1';
            }, 150);
          }
        }
      }
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        setActiveButton(btn);
      });
    });
  });
</script>

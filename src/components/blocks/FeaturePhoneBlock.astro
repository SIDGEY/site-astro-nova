---
import Mobile from "../Mobile.astro";

interface GalleryImage {
  src: string;
  alt?: string;
}

interface Props {
  icon: string;
  title: string;
  subtitle: string;
  screenshot1: string;
  screenshot2: string;
  backgroundImage?: string;
  reversed?: boolean;
  gallery?: GalleryImage[];
  galleryExtra?: number;
  resourceIcons?: { icon: string; active?: boolean }[];
}

const {
  icon,
  title,
  subtitle,
  screenshot1,
  screenshot2,
  backgroundImage,
  reversed = false,
  gallery = [],
  galleryExtra = 0,
  resourceIcons = [],
} = Astro.props;
---

<section
  class="overflow-hidden relative bg-[#0B1120] py-20 md:py-[120px] px-6 md:px-12 lg:px-20 flex items-center"
  style={backgroundImage
    ? `background-image: url('${backgroundImage}'); background-repeat: no-repeat; background-position: center; background-size: cover;`
    : ""}
>
  <div
    class={`max-w-7xl mx-auto w-full grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center`}
  >
    <!-- Text side -->
    <div
      class={`flex flex-col items-center md:items-start text-center md:text-left z-10 ${reversed ? "md:order-2" : "md:order-1"}`}
    >
      <i
        class={`ph ph-${icon} mb-6`}
        style="font-size: 48px; background: linear-gradient(180deg, #90A1B9 0%, rgba(248, 250, 252, 0.2) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
      ></i>
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-6 text-slate-50">
        {title}
      </h2>
      <p class="text-base md:text-lg text-slate-400 mb-8 leading-relaxed">
        {subtitle}
      </p>

      {
        resourceIcons.length > 0 && (
          <div class="flex gap-3 mb-6">
            {resourceIcons.map((ri) => (
              <button
                class={`w-12 h-12 rounded-lg flex items-center justify-center transition-all ${
                  ri.active
                    ? "border-2 border-blue-500 bg-slate-900/80 text-white"
                    : "border border-slate-700 bg-slate-900/50 text-slate-400 hover:border-slate-500"
                }`}
              >
                <i class={`ph ph-${ri.icon} text-xl`} />
              </button>
            ))}
          </div>
        )
      }

      {
        gallery.length > 0 && (
          <div class="hidden md:flex gap-2 mt-2">
            {gallery.map((img, i) => (
              <div
                class={`w-14 h-14 rounded-lg overflow-hidden border ${
                  i === 0 ? "border-blue-500" : "border-slate-700/50"
                } ${i === 0 ? "" : "opacity-50"}`}
              >
                <img
                  src={img.src}
                  alt={img.alt || ""}
                  class="w-full h-full object-cover"
                />
              </div>
            ))}
            {galleryExtra > 0 && (
              <div class="w-14 h-14 rounded-lg border border-slate-700/50 flex items-center justify-center text-slate-400 text-sm bg-slate-900/50">
                +{galleryExtra}
              </div>
            )}
          </div>
        )
      }
    </div>

    <!-- Phones side -->
    <div
      class={`flex justify-center items-center gap-4 md:gap-6 relative ${reversed ? "md:order-1" : "md:order-2"}`}
    >
      <div class="relative z-10">
        <Mobile screenshot={screenshot1} />
      </div>
      <div class="relative z-0 hidden sm:block">
        <Mobile screenshot={screenshot2} />
      </div>

      <!-- Mobile: floating gallery thumbnails -->
      {
        gallery.length > 0 && (
          <div class="absolute -bottom-4 left-0 right-0 flex sm:hidden gap-2 justify-center">
            {gallery.slice(0, 2).map((img, i) => (
              <div
                class={`w-20 h-20 rounded-xl overflow-hidden border-2 shadow-lg ${
                  i === 0 ? "border-blue-500" : "border-slate-700/50"
                }`}
              >
                <img
                  src={img.src}
                  alt={img.alt || ""}
                  class="w-full h-full object-cover"
                />
              </div>
            ))}
          </div>
        )
      }

      <!-- Mobile: floating resource icons -->
      {
        resourceIcons.length > 0 && (
          <div class="absolute -bottom-4 left-4 right-4 flex sm:hidden gap-3 justify-center">
            {resourceIcons.slice(0, 2).map((ri) => (
              <div class="w-20 h-20 rounded-xl border-2 border-slate-700/50 bg-slate-900/80 backdrop-blur-sm flex items-center justify-center shadow-lg">
                <i class={`ph ph-${ri.icon} text-3xl text-slate-300`} />
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>

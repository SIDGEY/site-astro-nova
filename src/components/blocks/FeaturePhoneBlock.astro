---
import Mobile from "../Mobile.astro";

interface GalleryImage {
  src: string;
  alt?: string;
  screenshot?: string;
}

interface Props {
  icon: string;
  title: string;
  subtitle: string;
  screenshot1: string;
  screenshot2: string;
  backgroundImage?: string;
  reversed?: boolean;
  gallery?: GalleryImage[];
  galleryExtra?: number;
  resourceIcons?: { icon: string; active?: boolean; screenshot?: string }[];
}

const {
  icon,
  title,
  subtitle,
  screenshot1,
  screenshot2,
  backgroundImage,
  reversed = false,
  gallery = [],
  galleryExtra = 0,
  resourceIcons = [],
} = Astro.props;

// Generate a unique ID for this section instance
const sectionId = `feature-phone-${Math.random().toString(36).slice(2, 9)}`;

// Determine which phone is active (the one whose screenshot changes)
// Normal: Phone1 = context (center, col-span-2), Phone2 = active (far, col-span-1)
// Reversed: Phone1 = active (far, col-span-1), Phone2 = context (center, col-span-2)
// The "context" phone is always the larger one (col-span-2)
// The "active" phone is always the smaller one (col-span-1)
---

<section
  class={`feature-phone-section overflow-hidden relative bg-[#0B1120] py-20 md:py-[128px] px-6 md:px-12 lg:px-20 flex items-center ${reversed ? 'is-reversed' : ''}`}
  id={sectionId}
  data-reversed={reversed.toString()}
>
  <!-- Background image layers -->
  {backgroundImage && (
    <div class="absolute inset-0 z-[0] pointer-events-none w-full h-full bg-[#121B2E]">
      <!-- Image 75% width & its overlays -->
      <div
        class={`absolute opacity-80 top-0 bottom-0 w-[75%] ${reversed ? 'right-0 left-auto' : 'left-0 right-auto'}`}
        style={`background: linear-gradient(${reversed ? '76.97deg' : '283.03deg'}, #121B2E 18.79%, rgba(22, 32, 50, 0) 83.76%), linear-gradient(${reversed ? '40.96deg' : '319.04deg'}, #121B2E 20%, rgba(22, 32, 50, 0) 100%), url('${backgroundImage}'); background-repeat: no-repeat; background-position: center center; background-size: cover;`}
      ></div>

      <!-- Global Overlay 100% width -->
      <div
        class="absolute inset-0 w-full h-full"
        style={`background: linear-gradient(360deg, rgba(2, 6, 24, 0.5) 0%, rgba(22, 32, 50, 0) 100.04%), linear-gradient(${reversed ? '63.33deg' : '296.67deg'}, #020618 0%, rgba(22, 32, 50, 0) 66.72%);`}
      ></div>
    </div>
  )}

  <!-- Desktop layout: 3-column grid [1fr 232px 1fr] so center phone is always perfectly aligned -->
  <div
    class="relative z-[2] max-w-7xl mx-auto w-full hidden sm:grid items-center"
    style="grid-template-columns: 1fr 232px 1fr; column-gap: 32px;"
  >
    <!-- Left column -->
    <div
      class={`flex items-center ${
        reversed
          ? "justify-start order-1"
          : "justify-end order-1"
      }`}
    >
      {reversed ? (
        <!-- Reversed: text on the left -->
        <div class="flex flex-col items-start text-left z-10 pr-4 pl-12">
          <i
            class={`ph ph-regular ph-${icon} mb-6 opacity-80`}
            style="font-size: 48px; background: linear-gradient(180deg, #90A1B9 0%, rgba(248, 250, 252, 0.2) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
          ></i>
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-6 text-slate-50">
            {title}
          </h2>
          <p class="text-base md:text-lg text-slate-400 mb-16 leading-relaxed">
            {subtitle}
          </p>
          {
            resourceIcons.length > 0 && (
              <div class="relative flex gap-3 h-14 items-center mb-6" data-resource-buttons>
                <div
                  data-resource-indicator
                  class="absolute w-14 h-14 rounded-lg outline outline-2 outline-blue-500 outline-offset-2 pointer-events-none z-10 top-1/2 -translate-y-1/2 transition-[left] duration-300 ease-out"
                  style="left: 0px;"
                ></div>
                {resourceIcons.map((ri, index) => (
                  <button
                    class={`resource-btn w-14 h-14 rounded-lg flex items-center justify-center transition-all cursor-pointer hover:text-slate-50 text-slate-300 ${
                      ri.active ? "bg-slate-900" : "opacity-50"
                    }`}
                    data-index={index}
                    data-screenshot={ri.screenshot || ""}
                    data-active={ri.active ? "true" : "false"}
                  >
                    <i class={`ph ph-fill ph-${ri.icon} text-2xl`} />
                  </button>
                ))}
              </div>
            )
          }
          {
            gallery.length > 0 && (
              <div class="relative flex gap-3 h-[68px] items-center" data-gallery-buttons>
                {/* Border indicator — moves via JS, sits outside overflow-hidden buttons */}
                <div
                  data-gallery-indicator
                  class="absolute w-[51px] h-16 rounded-md outline outline-2 outline-blue-500 outline-offset-2 pointer-events-none z-10 top-1/2 -translate-y-1/2 transition-[left] duration-300 ease-out"
                  style="left: 0px;"
                ></div>
                {gallery.map((img, i) => (
                  <button
                    class={`gallery-btn w-[51px] h-16 rounded-md overflow-hidden cursor-pointer transition-all duration-300 ${i === 0 ? "" : "opacity-50"}`}
                    data-index={i}
                    data-screenshot={img.screenshot || img.src}
                    data-active={i === 0 ? "true" : "false"}
                  >
                    <div class="relative w-full h-full">
                      <img
                        src={img.src}
                        alt={img.alt || ""}
                        class={`w-full h-full object-cover transition-all duration-200 ${i === 0 ? "" : "grayscale"}`}
                      />
                      <div class="image-overlay"></div>
                      <div class="absolute inset-0 rounded-md border border-slate-600/50 pointer-events-none"></div>
                    </div>
                  </button>
                ))}
                {galleryExtra > 0 && (
                  <div class="w-[51px] h-16 rounded-md overflow-hidden opacity-50 cursor-default transition-all duration-300">
                    <div class="relative w-full h-full bg-slate-900/20 flex items-center justify-center">
                      <span class="text-slate-400 text-sm font-medium">+{galleryExtra}</span>
                      <div class="absolute inset-0 rounded-md border border-slate-700 pointer-events-none"></div>
                    </div>
                  </div>
                )}
              </div>
            )
          }
        </div>
      ) : (
        <!-- Normal: active phone on the left -->
        <div class="relative z-0">
          <Mobile
            screenshot={gallery.length > 0 ? (gallery[0].screenshot || gallery[0].src) : screenshot2}
            dataRole="active-phone"
          />
        </div>
      )}
    </div>

    <!-- Center column: context phone (always 232px, always centered) -->
    <div class="relative z-10 order-2 flex justify-center">
      <Mobile
        screenshot={screenshot1}
        dataRole="context-phone"
      />
    </div>

    <!-- Right column -->
    <div
      class={`flex items-center ${
        reversed
          ? "justify-start order-3"
          : "justify-start order-3"
      }`}
    >
      {reversed ? (
        <!-- Reversed: active phone on the right -->
        <div class="relative z-0">
          <Mobile
            screenshot={gallery.length > 0 ? (gallery[0].screenshot || gallery[0].src) : screenshot2}
            dataRole="active-phone"
          />
        </div>
      ) : (
        <!-- Normal: text on the right -->
        <div class="flex flex-col items-start text-left z-10 pl-4 pr-12">
          <i
            class={`ph ph-regular ph-${icon} mb-6 opacity-80`}
            style="font-size: 48px; background: linear-gradient(180deg, #90A1B9 0%, rgba(248, 250, 252, 0.2) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
          ></i>
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-6 text-slate-50">
            {title}
          </h2>
          <p class="text-base md:text-lg text-slate-400 mb-16 leading-relaxed">
            {subtitle}
          </p>
          {
            resourceIcons.length > 0 && (
              <div class="relative flex gap-3 h-14 items-center mb-6" data-resource-buttons>
                <div
                  data-resource-indicator
                  class="absolute w-14 h-14 rounded-lg outline outline-2 outline-blue-500 outline-offset-2 pointer-events-none z-10 top-1/2 -translate-y-1/2 transition-[left] duration-300 ease-out"
                  style="left: 0px;"
                ></div>
                {resourceIcons.map((ri, index) => (
                  <button
                    class={`resource-btn w-14 h-14 rounded-lg flex items-center justify-center transition-all cursor-pointer hover:text-slate-50 text-slate-300 ${
                      ri.active ? "bg-slate-900" : "opacity-50"
                    }`}
                    data-index={index}
                    data-screenshot={ri.screenshot || ""}
                    data-active={ri.active ? "true" : "false"}
                  >
                    <i class={`ph ph-fill ph-${ri.icon} text-2xl`} />
                  </button>
                ))}
              </div>
            )
          }
          {
            gallery.length > 0 && (
              <div class="relative flex gap-3 h-[68px] items-center" data-gallery-buttons>
                {/* Border indicator — moves via JS, sits outside overflow-hidden buttons */}
                <div
                  data-gallery-indicator
                  class="absolute w-[51px] h-16 rounded-md outline outline-2 outline-blue-500 outline-offset-2 pointer-events-none z-10 top-1/2 -translate-y-1/2 transition-[left] duration-300 ease-out"
                  style="left: 0px;"
                ></div>
                {gallery.map((img, i) => (
                  <button
                    class={`gallery-btn w-[51px] h-16 rounded-md overflow-hidden cursor-pointer transition-all duration-300 ${i === 0 ? "" : "opacity-50"}`}
                    data-index={i}
                    data-screenshot={img.screenshot || img.src}
                    data-active={i === 0 ? "true" : "false"}
                  >
                    <div class="relative w-full h-full">
                      <img
                        src={img.src}
                        alt={img.alt || ""}
                        class={`w-full h-full object-cover transition-all duration-200 ${i === 0 ? "" : "grayscale"}`}
                      />
                      <div class="image-overlay"></div>
                      <div class="absolute inset-0 rounded-md border border-slate-600/50 pointer-events-none"></div>
                    </div>
                  </button>
                ))}
                {galleryExtra > 0 && (
                  <div class="w-[51px] h-16 rounded-md overflow-hidden opacity-50 cursor-default transition-all duration-300">
                    <div class="relative w-full h-full bg-slate-900/20 flex items-center justify-center">
                      <span class="text-slate-400 text-sm font-medium">+{galleryExtra}</span>
                      <div class="absolute inset-0 rounded-md border border-slate-700 pointer-events-none"></div>
                    </div>
                  </div>
                )}
              </div>
            )
          }
        </div>
      )}
    </div>
  </div>

  <!-- Mobile layout: text above, media below -->
  <div class="flex sm:hidden flex-col items-center gap-10 relative z-[2] w-full">

    <!-- Text zone (centered) -->
    <div class="flex flex-col items-center text-center">
      <i
        class={`ph ph-regular ph-${icon} mb-5 opacity-80`}
        style="font-size: 40px; background: linear-gradient(180deg, #90A1B9 0%, rgba(248, 250, 252, 0.2) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
      ></i>
      <h2 class="text-2xl font-bold mb-3 text-slate-50">{title}</h2>
      <p class="text-base text-slate-400 leading-relaxed">{subtitle}</p>
    </div>

    <!-- Media zone: gallery mode — phone centered with 2 overlapping cards -->
    {gallery.length > 0 && (
      <div class="relative w-full flex justify-center">
        {/* Left card — behind the phone */}
        <div class="absolute bottom-4 left-4 z-0 w-24 h-24 rounded-2xl overflow-hidden border-2 border-blue-500 shadow-2xl">
          <img src={gallery[0].src} alt={gallery[0].alt || ""} class="w-full h-full object-cover" />
          <div class="image-overlay"></div>
        </div>
        {/* Phone */}
        <div class="relative z-10">
          <Mobile screenshot={screenshot1} dataRole="context-phone-mobile" />
        </div>
        {/* Right card — in front of the phone */}
        {gallery.length > 1 && (
          <div class="absolute bottom-0 right-4 z-20 w-24 h-24 rounded-2xl overflow-hidden border-2 border-slate-700/50 shadow-2xl">
            <img src={gallery[1].src} alt={gallery[1].alt || ""} class="w-full h-full object-cover" />
            <div class="image-overlay"></div>
          </div>
        )}
      </div>
    )}

    <!-- Media zone: resource icons mode — phone + icon row below -->
    {resourceIcons.length > 0 && gallery.length === 0 && (
      <div class="flex flex-col items-center gap-6 w-full">
        <Mobile screenshot={screenshot1} dataRole="context-phone-mobile" />
        <div class="flex gap-3 justify-center flex-wrap">
          {resourceIcons.map((ri) => (
            <div
              class={`w-14 h-14 rounded-xl flex items-center justify-center border transition-all ${
                ri.active
                  ? "bg-slate-800 border-blue-500/60"
                  : "bg-slate-900/80 border-slate-700/50 opacity-50"
              }`}
            >
              <i class={`ph ph-fill ph-${ri.icon} text-2xl text-slate-300`} />
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Media zone: default (no gallery, no resource icons) -->
    {gallery.length === 0 && resourceIcons.length === 0 && (
      <Mobile screenshot={screenshot1} dataRole="context-phone-mobile" />
    )}
  </div>
</section>


<script define:vars={{ sectionId }}>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById(sectionId);
    if (!section) return;

    const buttons = section.querySelectorAll('.resource-btn[data-screenshot]');
    const galleryButtons = section.querySelectorAll('.gallery-btn[data-screenshot]');
    if (buttons.length === 0 && galleryButtons.length === 0) return;

    // Find the active phone (the "far" one that should change)
    const activePhone = section.querySelector('[data-role="active-phone"]');
    const activePhoneMobile = section.querySelector('[data-role="active-phone-mobile"]');

    function updatePhoneScreenshot(screenshot) {
      if (!screenshot) return;
      // Find the screenshot img inside the active phone container
      if (activePhone) {
        const img = activePhone.querySelector('img[alt="Screenshot"]');
        if (img) {
          img.style.opacity = '0';
          img.style.transition = 'opacity 0.3s ease';
          setTimeout(() => {
            img.src = screenshot;
            img.style.opacity = '1';
          }, 150);
        }
      }
      if (activePhoneMobile) {
        const imgMobile = activePhoneMobile.querySelector('img[alt="Screenshot"]');
        if (imgMobile) {
          imgMobile.style.opacity = '0';
          imgMobile.style.transition = 'opacity 0.3s ease';
          setTimeout(() => {
            imgMobile.src = screenshot;
            imgMobile.style.opacity = '1';
          }, 150);
        }
      }
    }

    function setActiveButton(clickedBtn) {
      const container = clickedBtn.closest('[data-resource-buttons]');
      if (!container) return;

      const indicator = container.querySelector('[data-resource-indicator]');
      if (indicator) indicator.style.left = clickedBtn.offsetLeft + 'px';

      container.querySelectorAll('.resource-btn').forEach((btn) => {
        btn.classList.add('opacity-50');
        btn.classList.remove('bg-slate-900');
        btn.dataset.active = 'false';
      });

      clickedBtn.classList.remove('opacity-50');
      clickedBtn.classList.add('bg-slate-900');
      clickedBtn.dataset.active = 'true';

      updatePhoneScreenshot(clickedBtn.dataset.screenshot);
    }

    function setActiveGalleryButton(clickedBtn) {
      const container = clickedBtn.closest('[data-gallery-buttons]');
      if (!container) return;

      // Move indicator to clicked button
      const indicator = container.querySelector('[data-gallery-indicator]');
      if (indicator) indicator.style.left = clickedBtn.offsetLeft + 'px';

      // Reset all buttons to inactive state (opacity-50 + grayscale on img)
      container.querySelectorAll('.gallery-btn').forEach((btn) => {
        btn.classList.add('opacity-50');
        btn.dataset.active = 'false';
        const img = btn.querySelector('img');
        if (img) img.classList.add('grayscale');
      });

      // Set clicked button to active state
      clickedBtn.classList.remove('opacity-50');
      clickedBtn.dataset.active = 'true';
      const activeImg = clickedBtn.querySelector('img');
      if (activeImg) activeImg.classList.remove('grayscale');

      updatePhoneScreenshot(clickedBtn.dataset.screenshot);
    }

    // Init resource indicator to the initially active button
    section.querySelectorAll('[data-resource-buttons]').forEach((container) => {
      const activeBtn = container.querySelector('.resource-btn[data-active="true"]');
      const indicator = container.querySelector('[data-resource-indicator]');
      if (activeBtn && indicator) indicator.style.left = activeBtn.offsetLeft + 'px';
    });

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        setActiveButton(btn);
      });
    });

    galleryButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        setActiveGalleryButton(btn);
      });
    });
  });
</script>

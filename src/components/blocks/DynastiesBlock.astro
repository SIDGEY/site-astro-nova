---
/**
 * Bloc « Choisissez votre dynastie » de la home : une colonne plein cadre par dynastie jouable, la
 * scène de l'écran de choix du jeu en fond, et un appel à créer son compte. Tout vient du catalogue
 * synchronisé (`lib/game.ts`) ; le Chœur, pas encore jouable, n'y figure pas.
 *
 * Le CTA de chaque colonne nomme sa dynastie (« Choisir l'Héritage ») : le `play_click` du site
 * relève le texte du lien, ce qui dit quelle dynastie a fait partir le visiteur vers le jeu.
 */
import { dynasties } from "../../lib/game";

interface Props {
  title: string;
  subtitle?: string;
  sectionId?: string;
  /** Le verbe du CTA, suivi du nom de la dynastie. */
  ctaText?: string;
  ctaLink?: string;
  /** Une ligne sous chaque CTA, pour dire que l'inscription est gratuite. */
  ctaNote?: string;
}

const { title, subtitle, sectionId, ctaText = "Choisir", ctaLink, ctaNote } = Astro.props;

// Couleur d'accent de chaque dynastie, tirée de son identité visuelle (codex, LORE_BRIEF §1).
const ACCENT: Record<string, string> = {
  heritage: "#FB923C",
  accord: "#2DD4BF",
};
// Cadrage horizontal de la scène : la bannière suspendue y est le point focal.
const FOCUS: Record<string, string> = {
  heritage: "60% center",
  accord: "50% center",
};

const columns = dynasties
  .filter((d) => d.playable)
  .map((d) => ({
    ...d,
    accent: ACCENT[d.code] ?? "#90A1B9",
    focus: FOCUS[d.code] ?? "center",
    // « L'Héritage » devient « l'Héritage » au milieu de la phrase du CTA.
    cta: `${ctaText} ${d.name.charAt(0).toLowerCase()}${d.name.slice(1)}`,
  }));
---

<section id={sectionId} class="relative overflow-hidden bg-[#020618]">
  <div class="relative z-10 px-6 md:px-12 pt-20 md:pt-[128px] pb-10 md:pb-12">
    <div class="flex flex-col items-center text-center gap-4 max-w-3xl mx-auto">
      <i
        class="ph ph-crown block opacity-40"
        style="font-size: 48px; background: linear-gradient(180deg, #90A1B9 0%, rgba(248, 250, 252, 0.2) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
      ></i>
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-slate-50">{title}</h2>
      {subtitle && <p class="text-base md:text-xl text-slate-400 mb-0">{subtitle}</p>}
    </div>
  </div>

  <div class="dynasty-split flex flex-col md:flex-row">
    {
      columns.map((d) => (
        <article
          class="dynasty-col group relative flex items-end min-h-[560px] md:min-h-[min(82vh,800px)] overflow-hidden"
          style={`--accent: ${d.accent};`}
        >
          <img
            src={d.scene}
            alt=""
            loading="lazy"
            decoding="async"
            width="1376"
            height="768"
            class="dynasty-scene absolute inset-0 w-full h-full object-cover"
            style={`object-position: ${d.focus};`}
          />
          <div class="absolute inset-0 bg-gradient-to-b from-[#020618] via-transparent via-30% to-transparent" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#020618] via-[#020618]/70 via-35% to-transparent to-70%" />

          <div class="relative z-10 w-full flex flex-col items-center text-center gap-3 px-6 pb-16 md:pb-20">
            {d.people && <p class="dynasty-accent text-xs md:text-sm font-semibold uppercase tracking-[0.2em] mb-0">{d.people}</p>}
            <h3 class="text-4xl md:text-5xl lg:text-6xl font-bold text-slate-50 mb-0">{d.name}</h3>
            <p class="text-lg md:text-xl italic text-slate-200 mb-0">« {d.motto} »</p>
            {ctaLink && (
              <a
                href={ctaLink}
                class="dynasty-cta mt-5 flex items-center justify-center h-12 px-7 w-full sm:w-auto rounded-lg font-semibold text-lg text-slate-950 transition-[filter] hover:brightness-110"
              >
                {d.cta}
              </a>
            )}
            {ctaNote && <p class="text-sm text-slate-400 mb-0">{ctaNote}</p>}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .dynasty-col {
    flex: 1 1 0;
  }
  .dynasty-col + .dynasty-col {
    border-top: 1px solid rgb(148 163 184 / 0.12);
  }
  .dynasty-accent {
    color: var(--accent);
  }
  .dynasty-cta {
    background: var(--accent);
  }

  @media (min-width: 768px) {
    .dynasty-col + .dynasty-col {
      border-top: 0;
      border-left: 1px solid rgb(148 163 184 / 0.12);
    }
  }

  /* La colonne survolée s'élargit et s'éclaire, l'autre recule. */
  @media (min-width: 768px) and (hover: hover) and (prefers-reduced-motion: no-preference) {
    .dynasty-col {
      transition: flex-grow 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .dynasty-scene {
      transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1), filter 0.6s ease;
    }
    .dynasty-split:hover .dynasty-col:hover {
      flex-grow: 1.3;
    }
    .dynasty-col:hover .dynasty-scene {
      transform: scale(1.04);
    }
    .dynasty-split:hover .dynasty-col:not(:hover) .dynasty-scene {
      filter: brightness(0.6) saturate(0.8);
    }
  }
</style>

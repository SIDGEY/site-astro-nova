---
/**
 * Bloc « Choisissez votre dynastie » de la home. Tout vient de l'écran de choix du jeu, via le
 * catalogue synchronisé (`lib/game.ts`) : nom, peuple, devise, récit, traits, scène et bannière.
 * Le Chœur, qui n'est pas jouable, n'apparaît que par sa devise : c'est la carte « teaser ».
 */
import { dynasties } from "../../lib/game";

interface Props {
  title: string;
  subtitle?: string;
  sectionId?: string;
  ctaText?: string;
  ctaLink?: string;
}

const { title, subtitle, sectionId, ctaText, ctaLink } = Astro.props;

// Couleur d'accent de chaque dynastie, tirée de son identité visuelle (codex, LORE_BRIEF §1).
const ACCENT: Record<string, string> = {
  heritage: "#FB923C",
  accord: "#2DD4BF",
  choir: "#A78BFA",
};

// Les deux premières phrases du récit sur la carte, la suite sous « Lire leur histoire ».
const EXCERPT_SENTENCES = 2;
const cards = dynasties.map((d) => {
  const sentences = d.fiction.split(/(?<=[.!?])\s+/).filter(Boolean);
  return {
    ...d,
    accent: ACCENT[d.code] ?? "#90A1B9",
    excerpt: sentences.slice(0, EXCERPT_SENTENCES).join(" "),
    rest: sentences.slice(EXCERPT_SENTENCES).join(" "),
  };
});
---

<section
  id={sectionId}
  class="relative overflow-hidden bg-[#0B1120] px-6 md:px-12 lg:px-20 py-20 md:py-[128px]"
>
  <div class="relative z-10 max-w-7xl mx-auto flex flex-col gap-12">
    <div class="flex flex-col items-center text-center gap-4 max-w-3xl mx-auto">
      <i
        class="ph ph-crown block opacity-40"
        style="font-size: 48px; background: linear-gradient(180deg, #90A1B9 0%, rgba(248, 250, 252, 0.2) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
      ></i>
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-slate-50">{title}</h2>
      {subtitle && <p class="text-base md:text-xl text-slate-400 mb-0">{subtitle}</p>}
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {
        cards.map((d) => (
          <article
            class:list={[
              "dynasty-card relative flex flex-col rounded-2xl overflow-hidden border bg-slate-900/80",
              d.playable ? "border-slate-700/60" : "border-slate-800",
            ]}
            style={`--accent: ${d.accent};`}
          >
            <div class="relative aspect-[16/9] overflow-hidden">
              <img
                src={d.scene}
                alt=""
                loading="lazy"
                decoding="async"
                class:list={["absolute inset-0 w-full h-full object-cover", !d.playable && "grayscale-[60%] opacity-60"]}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/30 to-transparent" />
              {!d.playable && (
                <span class="absolute top-3 right-3 inline-flex items-center gap-1.5 rounded-full bg-slate-950/70 backdrop-blur px-3 py-1 text-xs font-medium text-slate-300">
                  <i class="ph ph-lock-simple" aria-hidden="true" />
                  Pas encore jouable
                </span>
              )}
              <img
                src={d.banner}
                alt={`Bannière de ${d.name}`}
                loading="lazy"
                decoding="async"
                width="64"
                height="80"
                class="absolute left-5 -bottom-1 w-16 h-20 object-contain drop-shadow-lg"
              />
            </div>

            <div class="flex flex-col gap-4 p-6 pt-5 flex-1">
              <div class="flex flex-col gap-1">
                {d.people && <p class="text-xs uppercase tracking-wider text-slate-400 mb-0">{d.people}</p>}
                <h3 class="text-2xl font-bold text-slate-50 mb-0">{d.name}</h3>
              </div>
              <p class="dynasty-motto text-lg italic leading-snug mb-0">« {d.motto} »</p>

              {d.excerpt && <p class="text-sm leading-6 text-slate-300 mb-0">{d.excerpt}</p>}
              {d.rest && (
                <details class="group text-sm leading-6 text-slate-300">
                  <summary class="dynasty-more cursor-pointer list-none inline-flex items-center gap-1 font-medium">
                    Lire leur histoire
                    <i class="ph ph-caret-down transition-transform group-open:rotate-180" aria-hidden="true" />
                  </summary>
                  <p class="mt-2 mb-0">{d.rest}</p>
                </details>
              )}

              {d.traits.length > 0 && (
                <div class="mt-auto pt-4 border-t border-slate-800 flex flex-col gap-3">
                  <p class="text-xs uppercase tracking-wider text-slate-500 mb-0">Traits de dynastie</p>
                  {d.traits.map((t) => (
                    <div class="flex gap-3">
                      <i class="dynasty-trait ph ph-seal-check text-lg leading-6 shrink-0" aria-hidden="true" />
                      <p class="text-sm leading-6 text-slate-400 mb-0">
                        <span class="font-semibold text-slate-100">{t.name}.</span> {t.description}
                      </p>
                    </div>
                  ))}
                </div>
              )}
              {!d.playable && (
                <p class="mt-auto pt-4 border-t border-slate-800 text-sm leading-6 text-slate-400 mb-0">
                  Une troisième dynastie attend son heure.
                </p>
              )}
            </div>
          </article>
        ))
      }
    </div>

    {
      ctaText && ctaLink && (
        <div class="flex justify-center">
          <a
            href={ctaLink}
            class="group flex items-center justify-center gap-2 h-12 px-6 w-full sm:w-auto bg-blue-600 hover:bg-blue-500 text-white font-semibold text-lg rounded-lg transition-colors shadow-lg shadow-blue-600/25"
          >
            {ctaText}
            <i class="ph ph-bold ph-arrow-right transition-transform group-hover:translate-x-0.5"></i>
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  .dynasty-card {
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .dynasty-motto,
  .dynasty-more,
  .dynasty-trait {
    color: var(--accent);
  }
  .dynasty-more::-webkit-details-marker {
    display: none;
  }
</style>

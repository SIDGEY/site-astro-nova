---
interface CarouselItem {
  image: string;
  title: string;
  avatar?: string;
}

interface Props {
  icon: string;
  title: string;
  subtitle: string;
  items: CarouselItem[];
}

const { icon, title, subtitle, items } = Astro.props;
const carouselId = `carousel-${Math.random().toString(36).slice(2, 9)}`;
---

<section class="overflow-hidden relative bg-[#0B1120] py-20 md:py-28 px-0"
  style="background-image: url('/bg.svg'); background-repeat: no-repeat; background-position: center; background-size: cover;">

  <div class="text-center mb-12 px-6">
    <i class={`ph ph-${icon} text-4xl text-slate-500 mb-4 block`}></i>
    <h2 class="text-3xl md:text-5xl font-bold text-slate-50 mb-4">
      {title}
    </h2>
    <p class="text-base md:text-lg text-slate-400 max-w-2xl mx-auto">
      {subtitle}
    </p>
  </div>

  <div class="relative">
    <div id={carouselId} class="carousel-track flex gap-4 md:gap-6 overflow-x-auto scroll-smooth px-6 pb-4 snap-x snap-mandatory scrollbar-hide">
      {items.map((item) => (
        <div class="carousel-card flex-shrink-0 w-[200px] md:w-[220px] snap-center">
          <div class="relative rounded-xl overflow-hidden border border-slate-700/50 bg-slate-900/50 aspect-[3/4]">
            <img src={item.image} alt={item.title} class="w-full h-full object-cover" />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-4 flex flex-col items-center">
              {item.avatar && (
                <div class="w-12 h-12 rounded-full overflow-hidden border-2 border-slate-500 mb-2">
                  <img src={item.avatar} alt="" class="w-full h-full object-cover" />
                </div>
              )}
              <p class="text-white text-sm font-medium text-center">{item.title}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Dots -->
  <div class="flex justify-center gap-2 mt-6">
    <span class="w-2.5 h-2.5 rounded-full bg-white"></span>
    <span class="w-2.5 h-2.5 rounded-full bg-slate-600"></span>
    <span class="w-2.5 h-2.5 rounded-full bg-slate-600"></span>
  </div>
</section>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

---
/**
 * Barre du haut du jeu sous 768px : `Header` (menu, logo centré, messagerie, notifications) puis
 * la barre de ressources embarquée (`ResourceBar` / `ResourceBlock`, icône et valeur côte à côte).
 * Stocks, capacités et bilan d'énergie de l'empire d'illustration (`empire.ts`) ; la jauge sous
 * chaque bloc est le remplissage du stockage, ou le taux d'utilisation de l'énergie.
 */
import { gameFor, logo, RESOURCE_ORDER } from '../../lib/game';
import { localeFromPath } from '../../lib/i18n';
import { energyBalance, resourceBalance } from './empire';
import { compact, energyTone } from './format';

const locale = localeFromPath(Astro.url.pathname);
const { resources } = gameFor(locale);
const energy = energyBalance();
const tone = energyTone(energy.usage, energy.available);
const sample: Record<string, { value: string; fill: number }> = {
  ...Object.fromEntries(
    (['metal', 'crystal', 'hydrogen'] as const).map((code) => {
      const { stock, capacity } = resourceBalance(code);
      return [code, { value: compact(stock, locale), fill: Math.min((stock / capacity) * 100, 100) }];
    }),
  ),
  energy: { value: `${energy.usage}%`, fill: Math.min(energy.usage, 100) },
};
const gauge: Record<string, string> = { 'text-red-400': 'bg-red-400', 'text-orange-400': 'bg-orange-400', 'text-green-400': 'bg-green-400' };
---

<div class="shrink-0 relative z-10">
  <div class="border-b border-slate-700 relative">
    <div class="w-full px-3 py-1.5 flex bg-[#121E31] items-center justify-between">
      <span class="p-2.5 rounded-lg"><i class="ph ph-list text-2xl text-slate-200 block"></i></span>
      <img src={logo} alt="" class="absolute left-1/2 -translate-x-1/2 top-1/2 -mt-[8px] w-12 h-auto z-10" />
      <div class="flex items-center gap-1">
        <span class="p-2.5 rounded-lg"><i class="ph ph-chat-teardrop-dots text-2xl text-slate-200 block"></i></span>
        <span class="p-2.5 rounded-lg relative">
          <i class="ph ph-bell-simple text-2xl text-slate-200 block"></i>
          <span class="absolute top-2 right-2 w-2 h-2 rounded-full bg-red-500"></span>
        </span>
      </div>
    </div>
  </div>
  <div class="flex flex-row divide-x divide-slate-700 border-b border-slate-700 w-full bg-[#121E31]/80">
    {RESOURCE_ORDER.map((code) => {
      const isEnergy = code === 'energy';
      return (
        <div class="px-2 py-3.5 relative w-full">
          <div
            class={`absolute -bottom-[1px] left-0 h-0.5 ${isEnergy ? gauge[tone] : 'bg-blue-400'}`}
            style={`width: ${sample[code].fill}%`}
          />
          <div class="flex flex-row items-center justify-center gap-1.5 w-full">
            <i class={`ph-fill ph-${resources[code].icon} text-xl leading-none ${isEnergy ? tone : 'text-slate-400'}`}></i>
            <span class={`text-sm font-medium tabular-nums text-center max-w-[5ch] truncate ${isEnergy ? tone : ''}`}>{sample[code].value}</span>
          </div>
        </div>
      );
    })}
  </div>
</div>

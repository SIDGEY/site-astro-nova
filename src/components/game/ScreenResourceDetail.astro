---
/**
 * La fiche ressource du jeu (`ResourceModal`) sous 768px, dans la modale commune :
 *
 *   - en tête, l'illustration, le nom et le stock sur la capacité (pour l'énergie : consommation /
 *     production et taux d'utilisation) ;
 *   - la description longue repliée (`ExpandableText`) ;
 *   - pour une ressource extraite, le taux de fonctionnement de sa mine (`OperatingRateControl`) ;
 *   - le détail (`ResourceBreakdown`) : lignes de production et de stockage, ou pour l'énergie la
 *     production puis la consommation, chaque mine suivie de son taux de fonctionnement ;
 *   - au pied, « D'accord ».
 *
 * Nom, description, titres de section (« Production », « Stockage », « Consommation ») et bouton
 * sont écrits en dur en français dans le jeu (`resourceIconsData.ts`, `RESOURCE_DATA`,
 * `ResourceBreakdown`, `ResourceModal`) : la fiche du jeu anglais les montre ainsi, celle-ci aussi.
 *
 * Les panneaux de talents (conversion du surplus, talents de production ou d'énergie) n'existent
 * qu'avec une classe : l'empire d'illustration (`empire.ts`) n'en a pas.
 */
import { gameFor, gameT, type ResourceCode } from '../../lib/game';
import { localeFromPath } from '../../lib/i18n';
import { energyBalance, resourceBalance } from './empire';
import { compact } from './format';
import ScreenDetailRow from './ScreenDetailRow.astro';
import ScreenModal from './ScreenModal.astro';
import ScreenOperatingRate from './ScreenOperatingRate.astro';

interface Props {
  resource: ResourceCode;
}

const { resource } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
// Nom et description longue : `RESOURCE_DATA` du jeu, écrit en français, que la fiche affiche
// telle quelle dans le jeu anglais aussi. Les noms des bâtiments, eux, sont traduits.
const meta = gameFor('fr').resources[resource];
const building = (code: string) => gameFor(locale).pick('buildings', [code])[0];

const isEnergy = resource === 'energy';
const energy = energyBalance();
const balance = isEnergy ? undefined : resourceBalance(resource);
const mineOutput = balance ? balance.production.find((line) => line.code === balance.mine)?.value ?? 0 : 0;
const mineDraw = balance ? energy.consumers.find((c) => c.code === balance.mine)?.value ?? 0 : 0;
---

<ScreenModal image={meta.image} veil>
  <div slot="header">
    <h2 class="text-2xl font-semibold text-white mb-1">{meta.name}</h2>
    <div class="flex items-center gap-2">
      <span class="relative inline-flex shrink-0"><i class={`ph-fill ph-${meta.icon} text-xl leading-none text-slate-400`}></i></span>
      <p class="text-gray-300 tabular-nums">
        {isEnergy
          ? `${compact(energy.consumption, locale)} / ${compact(energy.production, locale)} (${energy.usage}%)`
          : `${compact(balance!.stock, locale)} / ${compact(balance!.capacity, locale)}`}
      </p>
    </div>
  </div>

  {meta.longDescription && (
    <div>
      <div class="text-slate-300 line-clamp-3">{meta.longDescription}</div>
      <span class="mt-2 inline-block text-sm font-medium text-blue-400">{gameT(locale, 'components/expandableText:more')}</span>
    </div>
  )}

  {balance && <ScreenOperatingRate output={resource} production={mineOutput} consumption={mineDraw} />}

  <div class="space-y-6">
    {balance ? (
      <>
        <div>
          <div class="mb-2 flex items-center justify-between gap-2 text-gray-400">
            <span>Production</span>
            <span class="text-slate-500">{compact(balance.productionTotal, locale)} /h</span>
          </div>
          <div class="space-y-3">
            {balance.production.map((line) => {
              const b = building(line.code);
              return <ScreenDetailRow image={b.image} badge={line.level} title={b.name} value={`+${compact(line.value, locale)} /h`} valueClass="text-green-400" />;
            })}
          </div>
        </div>
        <div>
          <div class="mb-2 flex items-center justify-between gap-2 text-gray-400">
            <span>Stockage</span>
            <span class="text-slate-500">{compact(balance.capacity, locale)}</span>
          </div>
          <div class="space-y-3">
            {balance.storage.map((line) => {
              const b = building(line.code);
              return <ScreenDetailRow image={b.image} badge={line.level} title={b.name} value={compact(line.value, locale)} valueClass="text-slate-200" />;
            })}
          </div>
        </div>
      </>
    ) : (
      <>
        <div>
          <div class="mb-2 flex items-center justify-between gap-2 text-gray-400"><span>Production</span></div>
          <div class="space-y-3">
            {energy.producers.map((line) => {
              const b = building(line.code);
              return (
                <div class="space-y-2">
                  <ScreenDetailRow image={b.image} badge={line.level} title={b.name} value={`+${compact(line.value, locale)} (${energy.share(line.value)}%)`} valueClass="text-green-400" />
                </div>
              );
            })}
          </div>
        </div>
        <div>
          <div class="mb-2 flex items-center justify-between gap-2 text-gray-400"><span>Consommation</span></div>
          <div class="space-y-3">
            <div class="flex gap-3 text-sm text-gray-500 items-start">
              <div class="rounded-full bg-slate-950/50 p-3 border border-gray-700/50"><i class="ph-bold ph-info block text-base leading-none text-gray-200"></i></div>
              <div>{gameT(locale, 'pages/building:operatingRate.hint')}</div>
            </div>
            {energy.consumers.map((line) => {
              const b = building(line.code);
              return (
                <div class="space-y-2">
                  <ScreenDetailRow image={b.image} badge={line.level} title={b.name} value={`-${compact(line.value, locale)} (${energy.share(line.value)}%)`} valueClass="text-amber-400" />
                  <ScreenOperatingRate output={line.res} production={line.output} consumption={line.value} />
                </div>
              );
            })}
          </div>
        </div>
      </>
    )}
  </div>

  <span slot="footer" class="w-full inline-flex h-12 items-center justify-center gap-2 whitespace-nowrap rounded-lg px-4 text-base font-medium text-white btn-raised btn-raised-blue">D'accord</span>
</ScreenModal>

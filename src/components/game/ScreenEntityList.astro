---
/**
 * Page de liste du jeu (bâtiments, installations, défenses, vaisseaux) sous 768px :
 * `PageHeader` (titre + bascule « Disponible », `Toggle`), `GameTabBar` en contrôle segmenté,
 * puis une section de la page (`EntityGrid` : titre de sous-section et cartes) au mode d'affichage
 * par défaut (`EntityCard` non compact : illustration 4/5 à gauche avec l'action et le compteur,
 * nom et description à droite, une carte par ligne).
 *
 * Le compteur suit le jeu : « Niveau 8 » pour un bâtiment (`level_counter`), « 18 unités » pour
 * une unité. L'action d'un bâtiment déjà construit est l'amélioration, en vert (`cardStyles.button`).
 */
import type { GameEntity } from '../../lib/game';

interface Tab {
  icon: string;
  label: string;
  active?: boolean;
}

interface Props {
  title: string;
  /** Titre de la section montrée (`SubSectionTitle`), celle où se trouvent les cartes. */
  section?: string;
  tabs?: Tab[];
  items: GameEntity[];
  /** Niveaux (bâtiments) ou quantités (unités), dans l'ordre des cartes. */
  counters?: number[];
  /** Unités (défenses, vaisseaux) : le compteur est une quantité, l'action reste « construire ». */
  units?: boolean;
}

const { title, section, tabs = [], items, counters = [], units = false } = Astro.props;
---

<div class="h-full flex flex-col">
  {/* `PageHeader` : px-5 pt-4 space-y-3, padding bas pour le fondu. */}
  <div class="shrink-0 relative px-5 pt-4 pb-2 space-y-3">
    <div class="flex justify-between items-center gap-2">
      <h1 class="text-xl font-semibold">{title}</h1>
      <div class="flex flex-row items-center justify-end gap-3 h-5">
        <span class="text-sm text-gray-400">Disponible</span>
        <span class="relative flex h-4 w-10 items-center rounded-[58px] border border-slate-700">
          <span class="absolute h-6 w-6 rounded-full -translate-x-px bg-gray-400"></span>
        </span>
      </div>
    </div>
    {tabs.length > 0 && (
      <div class="flex overflow-hidden">
        <div class="inline-flex shrink-0 rounded-lg min-w-full">
          {tabs.map((tab, i) => (
            <span
              class:list={[
                'flex-1 flex h-12 items-center justify-center gap-2 border px-3 py-3 text-sm font-medium text-white',
                tab.active ? 'border-blue-500 bg-blue-500/20' : 'border-slate-700 bg-slate-800',
                i === 0 && 'rounded-l-lg',
                i === tabs.length - 1 && 'rounded-r-lg',
                i > 0 && tabs[i - 1].active && 'border-l-0',
                i < tabs.length - 1 && tabs[i + 1].active && 'border-r-0',
              ]}
            >
              <i class={`ph ph-${tab.icon} text-xl leading-none shrink-0 ${tab.active ? 'text-blue-400' : 'text-slate-400'}`}></i>
              <span class="whitespace-nowrap">{tab.label}</span>
            </span>
          ))}
        </div>
      </div>
    )}
  </div>

  <div class="relative flex-1 min-h-0 overflow-hidden">
    <div class="px-5 pt-4 space-y-4">
      {section && <h2 class="relative text-sm font-semibold text-slate-500 uppercase tracking-wider">{section}</h2>}
      <div class="grid grid-cols-1 gap-4">
        {items.map((item, i) => {
          const count = counters[i] ?? 0;
          const upgrade = !units && count > 0;
          return (
            <div class="relative rounded-lg overflow-hidden card-with-border">
              <div class="grid grid-cols-2 gap-6">
                <div class="relative rounded-lg overflow-hidden bg-gray-700">
                  <div class="relative">
                    <img src={item.image} alt="" class="w-full aspect-[4/5] object-cover" loading="lazy" />
                    <div class="entity-veil"></div>
                  </div>
                  <div class="absolute bottom-2 right-2 px-2 py-1 bg-slate-900/90 backdrop-blur-sm rounded-md text-sm font-medium text-slate-200 shadow-lg">
                    {units ? `${count} unités` : `Niveau ${count}`}
                  </div>
                  <span class={`absolute top-2 left-2 p-2 rounded-md backdrop-blur-sm btn-raised ${upgrade ? 'btn-raised-green' : 'btn-raised-blue'}`}>
                    <i class={`ph ${upgrade ? 'ph-arrow-up-right' : 'ph-plus'} text-xl leading-none block text-white`}></i>
                  </span>
                </div>
                <div class="flex flex-col justify-between pt-5 pb-6 pr-6">
                  <div>
                    <h3 class="font-semibold line-clamp-2 break-words">{item.name}</h3>
                    {item.description && <p class="text-sm text-gray-400 mt-2 line-clamp-4">{item.description}</p>}
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</div>

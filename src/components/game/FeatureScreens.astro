---
/**
 * Les écrans d'un bloc « téléphone » de la home, déduits de sa famille de contenu :
 *
 *   - `context` : l'écran du téléphone central — la page de liste, la planète, la boutique ;
 *   - `active`  : la pile d'écrans du téléphone secondaire, un par entité mise en avant, dont la
 *                 galerie du bloc fait défiler l'affichage (`data-screen-index`).
 *
 * Niveaux, unités, coûts et durées viennent de l'empire d'illustration (`empire.ts`), calculés par
 * les formules du backend : `home.md` n'a à nommer que des codes d'entités du jeu.
 */
import GameScreen from './GameScreen.astro';
import ScreenEntityDetail from './ScreenEntityDetail.astro';
import ScreenEntityList from './ScreenEntityList.astro';
import ScreenPlanet from './ScreenPlanet.astro';
import ScreenResourceDetail from './ScreenResourceDetail.astro';
import ScreenShop from './ScreenShop.astro';
import { gameFor, gameT, type GameEntity, type ResourceCode } from '../../lib/game';
import { localeFromPath, quote, t } from '../../lib/i18n';
import { LEVELS, QUANTITIES, nextLevel, unitBuild } from './empire';

export type FeatureFamily = 'resources' | 'buildings' | 'facilities' | 'defenses' | 'ships' | 'shop';

interface Props {
  role: 'context' | 'active';
  family: FeatureFamily;
  /** Entités mises en avant (déjà résolues), ou codes de ressources pour `resources`. */
  items: GameEntity[] | ResourceCode[];
}

const { role, family, items } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const { nav, family: familyOf } = gameFor(locale);

// La page de liste de chaque famille, et la section où se trouvent ses cartes (catégories du jeu :
// `pages/building:category.*`, `pages/fleet:combatShips`, `pages/defense:categories.standard`),
// avec la bascule « Disponible » et le compteur des cartes de cette page. La carte de vaisseau
// écrit « unités » en dur (`ShipCard`) : le jeu anglais l'affiche ainsi.
type List = {
  title: string;
  tab: 'buildings' | 'build';
  tabs?: { icon: string; label: string; active?: boolean }[];
  section?: string;
  units?: boolean;
  available: string;
  counter: (count: number) => string;
};
const levelCounter = (level: number) => gameT(locale, 'pages/building:level_counter', { level });
const lists: Record<string, List> = {
  buildings: {
    title: nav.buildings,
    tab: 'buildings',
    tabs: [{ icon: 'hammer', label: nav.resources, active: true }, { icon: 'factory', label: nav.installations }],
    section: gameT(locale, 'pages/building:category.production'),
    available: gameT(locale, 'pages/building:available'),
    counter: levelCounter,
  },
  facilities: {
    title: nav.buildings,
    tab: 'buildings',
    tabs: [{ icon: 'hammer', label: nav.resources }, { icon: 'factory', label: nav.installations, active: true }],
    section: gameT(locale, 'pages/building:category.development'),
    available: gameT(locale, 'pages/building:available'),
    counter: levelCounter,
  },
  // Sous 768px, vaisseaux et défenses portent le titre de leur onglet de barre, « Docks »
  // (`components.navigation.build`, cf. ShipsPage et DefensePage) ; « Vaisseaux » et « Défense »
  // ne titrent la page qu'au-delà.
  defenses: {
    title: nav.build,
    tab: 'build',
    tabs: [{ icon: 'rocket', label: nav.ships }, { icon: 'shield-star', label: nav.defense, active: true }],
    section: gameT(locale, 'pages/defense:categories.standard'),
    units: true,
    available: gameT(locale, 'pages/defense:available'),
    counter: (count) => `${count} ${gameT(locale, 'pages/defense:units_label')}`,
  },
  ships: {
    title: nav.build,
    tab: 'build',
    tabs: [{ icon: 'rocket', label: nav.ships, active: true }, { icon: 'shield-star', label: nav.defense }],
    section: gameT(locale, 'pages/fleet:combatShips'),
    units: true,
    available: gameT(locale, 'pages/fleet:available'),
    counter: (count) => `${count} unités`,
  },
};

const list = lists[family];
const entities = items as GameEntity[];
// La page de liste montre la famille entière, en commençant par ce que le bloc met en avant.
const listed =
  family in lists
    ? [...entities, ...familyOf(family as 'buildings').filter((e) => !entities.some((x) => x.code === e.code))].slice(0, 5)
    : [];
// Niveau d'un bâtiment, ou nombre d'unités en poste.
const counters = listed.map((e) => (list?.units ? QUANTITIES[e.code] : LEVELS[e.code]) ?? 0);
---

{role === 'context' && (
  family === 'resources' ? (
    <ScreenPlanet />
  ) : family === 'shop' ? (
    <GameScreen label={t(locale, 'screen.shopShowcase')}>
      <ScreenShop view="showcase" />
    </GameScreen>
  ) : (
    <GameScreen activeTab={list.tab} label={t(locale, 'screen.list', { title: list.title, tab: list.tabs?.find((tab) => tab.active)?.label ?? '' })}>
      <ScreenEntityList title={list.title} tabs={list.tabs} section={list.section} items={listed} counters={counters} units={list.units} available={list.available} formatCounter={list.counter} />
    </GameScreen>
  )
)}

{role === 'active' && (
  family === 'shop' ? (
    <div class="absolute inset-0 game-screen-swap" data-screen-index="0" data-active="true">
      <GameScreen label={t(locale, 'screen.shopCollection')}>
        <ScreenShop view="collection" />
      </GameScreen>
    </div>
  ) : family === 'resources' ? (
    (items as ResourceCode[]).map((code, i) => (
      <div class="absolute inset-0 game-screen-swap" data-screen-index={i} data-active={i === 0 ? 'true' : 'false'}>
        <GameScreen chrome={false} label={t(locale, 'screen.resource')}>
          <ScreenResourceDetail resource={code} />
        </GameScreen>
      </div>
    ))
  ) : (
    entities.map((item, i) => (
      <div class="absolute inset-0 game-screen-swap" data-screen-index={i} data-active={i === 0 ? 'true' : 'false'}>
        <GameScreen chrome={false} label={t(locale, 'screen.entity', { name: quote(item.name, locale) })}>
          {list?.units ? (
            <ScreenEntityDetail item={item} kind="unit" unit={family === 'defenses' ? 'defense' : 'ship'} {...unitBuild(item.code)} />
          ) : (
            (() => {
              const next = nextLevel(item.code);
              return <ScreenEntityDetail item={item} kind="building" count={next.level} costs={next.costs} energy={next.energy} buildTime={next.buildTime} />;
            })()
          )}
        </GameScreen>
      </div>
    ))
  )
)}

---
import { getEntry } from "astro:content";

const settings = await getEntry("settings", "general");
if (!settings) return Astro.redirect("/404");
const { navigation } = settings.data;
---

<nav
  id="main-nav"
  class="fixed top-0 left-0 right-0 px-6 lg:px-8 transition-all duration-300 z-[999] py-5 bg-transparent"
>
  <div class="hidden lg:flex items-center justify-between h-10 w-full mx-auto">
    <div class="flex items-center justify-start">
      <a href="/">
        <img src="/logo.svg" alt="Dynasty Nova" class="h-11 w-auto" />
      </a>
    </div>
    <div class="flex items-center justify-end gap-8">
      <!-- Navigation links with gap-8 (32px) -->
      <div class="flex items-center text-base gap-8">
        <!-- Dropdown: Le jeu -->
        <div class="relative group">
          <button
            class="flex items-center gap-2 text-slate-300 hover:text-slate-200 transition-colors py-2"
          >
            <span>Le jeu</span>
            <i
              class="ph ph-bold ph-caret-down text-slate-300 text-base opacity-50"
            ></i>
          </button>
          <!-- Dropdown menu -->
          <div
            class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200"
          >
            <div
              class="bg-slate-800 border border-slate-700 rounded-md shadow-xl py-2 min-w-[200px]"
            >
              <a
                href="/#planets"
                class="block px-4 py-2 text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors"
              >
                Planètes
              </a>
              <a
                href="/#resources"
                class="block px-4 py-2 text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors"
              >
                Ressources
              </a>
              <a
                href="/#buildings"
                class="block px-4 py-2 text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors"
              >
                Bâtiments
              </a>
              <a
                href="/#laboratory"
                class="block px-4 py-2 text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors"
              >
                Technologies
              </a>
              <a
                href="/#defenses"
                class="block px-4 py-2 text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors"
              >
                Défenses
              </a>
              <a
                href="/#fleet"
                class="block px-4 py-2 text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors"
              >
                Vaisseaux
              </a>
              <a
                href="/#shop"
                class="block px-4 py-2 text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors"
              >
                Boutique
              </a>
            </div>
          </div>
        </div>
        <a
          href="/blog"
          class="text-slate-300 hover:text-slate-200 transition-colors py-2"
          >Blog</a
        >
        <a
          href="#community"
          class="text-slate-300 hover:text-slate-200 transition-colors py-2"
          >Communauté</a
        >
        <a
          href="#gallery"
          class="text-slate-300 hover:text-slate-200 transition-colors py-2"
          >Galerie</a
        >
        <a
          href="/roadmap"
          class="text-slate-300 hover:text-slate-200 transition-colors py-2"
          >Roadmap</a
        >
      </div>
      <!-- Buttons with gap-4 (16px) -->
      <div class="flex items-center gap-4">
        <button
          class="px-4 py-2 whitespace-nowrap bg-blue-600 hover:bg-blue-500 text-slate-50 rounded-md font-semibold text-base transition-colors h-10"
        >
          S'inscrire à la bêta
        </button>
        <a
          class="px-4 py-2 whitespace-nowrap border border-slate-600 text-slate-50 rounded-md font-semibold text-base transition-colors h-10 flex items-center hover:border-slate-500"
          href="/game"
        >
          Jouer
        </a>
      </div>
    </div>
  </div>

  <div class="lg:hidden flex items-center justify-between relative">
    <a href="/">
      <img src="/logo.svg" alt="Dynasty Nova" class="h-11 w-auto" />
    </a>
    <button
      id="mobile-menu-toggle"
      class="absolute top-0 right-0 flex items-center justify-center w-12 h-12 rounded-full bg-slate-950 hover:bg-slate-900/90 transition-colors z-[1000] overflow-hidden"
      aria-label="Ouvrir le menu"
    >
      <div class="relative w-6 h-6">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          fill="currentColor"
          viewBox="0 0 256 256"
          class="absolute inset-0 text-white transition-all duration-300 ease-in-out opacity-100 rotate-0 scale-100"
          id="icon-menu"
        >
          <path
            d="M224,128a8,8,0,0,1-8,8H40a8,8,0,0,1,0-16H216A8,8,0,0,1,224,128ZM40,72H216a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16ZM216,184H40a8,8,0,0,0,0,16H216a8,8,0,0,0,0-16Z"
          ></path>
        </svg>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          fill="currentColor"
          viewBox="0 0 256 256"
          class="absolute inset-0 text-white transition-all duration-300 ease-in-out opacity-0 rotate-90 scale-50"
          id="icon-close"
        >
          <path
            d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"
          ></path>
        </svg>
      </div>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="fixed left-0 right-0 bottom-0 backdrop-blur-xl flex items-center justify-center transition-all duration-500 opacity-0 pointer-events-none"
    style="top: 0; bottom: 0; background-color: rgba(30, 41, 59, 0.5);"
  >
    <div
      class="flex flex-col space-y-0 md:space-y-4 items-center text-center w-full px-12 md:px-6"
    >
      <!-- Le jeu section with submenu -->
      <div class="text-slate-200 py-4 text-2xl font-medium w-full">Le jeu</div>
      <div class="flex flex-col space-y-2 items-center text-center w-full">
        <a
          href="/#planets"
          class="text-slate-400 hover:text-blue-400 transition-colors py-2 text-lg"
          >Planètes</a
        >
        <a
          href="/#resources"
          class="text-slate-400 hover:text-blue-400 transition-colors py-2 text-lg"
          >Ressources</a
        >
        <a
          href="/#buildings"
          class="text-slate-400 hover:text-blue-400 transition-colors py-2 text-lg"
          >Bâtiments</a
        >
        <a
          href="/#laboratory"
          class="text-slate-400 hover:text-blue-400 transition-colors py-2 text-lg"
          >Technologies</a
        >
        <a
          href="/#defenses"
          class="text-slate-400 hover:text-blue-400 transition-colors py-2 text-lg"
          >Défenses</a
        >
        <a
          href="/#fleet"
          class="text-slate-400 hover:text-blue-400 transition-colors py-2 text-lg"
          >Vaisseaux</a
        >
        <a
          href="/#shop"
          class="text-slate-400 hover:text-blue-400 transition-colors py-2 text-lg"
          >Boutique</a
        >
      </div>
      <a
        href="/blog"
        class="text-slate-200 hover:text-blue-400 transition-colors py-4 text-2xl font-medium w-full"
        >Blog</a
      >
      <a
        href="#community"
        class="text-slate-200 hover:text-blue-400 transition-colors py-4 text-2xl font-medium w-full"
        >Communauté</a
      >
      <a
        href="#gallery"
        class="text-slate-200 hover:text-blue-400 transition-colors py-4 text-2xl font-medium w-full"
        >Galerie</a
      >
      <a
        href="/roadmap"
        class="text-slate-200 hover:text-blue-400 transition-colors py-4 text-2xl font-medium w-full"
        >Roadmap</a
      >
      <button
        class="text-slate-200 hover:text-blue-400 transition-colors py-4 text-2xl font-medium"
      >
        S'inscrire à la bêta
      </button>
      <a
        class="text-slate-200 hover:text-blue-400 transition-colors py-4 text-2xl font-medium"
        href="/game"
      >
        Jouer
      </a>
    </div>
  </div>
</nav>

<script is:inline>
  const menuToggle = document.getElementById("mobile-menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconMenu = document.getElementById("icon-menu");
  const iconClose = document.getElementById("icon-close");
  const mobileLinks = mobileMenu?.querySelectorAll("a");

  const setMenuOpen = (isOpen) => {
    if (!menuToggle || !mobileMenu || !iconMenu || !iconClose) return;

    // Toggle Menu Visibility
    if (isOpen) {
      mobileMenu.classList.remove("opacity-0", "pointer-events-none");
    } else {
      mobileMenu.classList.add("opacity-0", "pointer-events-none");
    }

    // Toggle Icons
    if (isOpen) {
      iconMenu.classList.add("opacity-0", "rotate-90", "scale-50");
      iconMenu.classList.remove("opacity-100", "rotate-0", "scale-100");

      iconClose.classList.add("opacity-100", "rotate-0", "scale-100");
      iconClose.classList.remove("opacity-0", "rotate-90", "scale-50");
    } else {
      iconMenu.classList.add("opacity-100", "rotate-0", "scale-100");
      iconMenu.classList.remove("opacity-0", "rotate-90", "scale-50");

      iconClose.classList.add("opacity-0", "rotate-90", "scale-50");
      iconClose.classList.remove("opacity-100", "rotate-0", "scale-100");
    }

    menuToggle.setAttribute("aria-expanded", String(isOpen));
  };

  if (menuToggle) {
    menuToggle.addEventListener("click", () => {
      const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
      setMenuOpen(!isOpen);
    });
  }

  if (mobileLinks) {
    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => setMenuOpen(false));
    });
  }

  const nav = document.getElementById("main-nav");

  window.addEventListener("scroll", () => {
    if (window.scrollY > 100) {
      // Classes à ajouter au scroll (fond sombre + bordure)
      nav.classList.add("bg-slate-900", "border-b", "border-slate-800");
      nav.classList.remove("bg-transparent");
    } else {
      // Retour à l'état initial (transparent)
      nav.classList.remove("bg-slate-900", "border-b", "border-slate-800");
      nav.classList.add("bg-transparent");
    }
  });
</script>

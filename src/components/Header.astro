---
import { getEntry } from "astro:content";
const settings = await getEntry("settings", "general");
if (!settings) return Astro.redirect("/404");

const PLAY_URL = "https://play.dynastynova.com";

// Les sections de la home : sous-menu « Le jeu » (dropdown en desktop, accordéon en mobile).
// En desktop, « Le jeu » mène aussi à la première d'entre elles (les clics y étaient perdus).
const gameLinks = [
  { href: "/#dynasties", label: "Dynasties", icon: "crown" },
  { href: "/#planets", label: "Planètes", icon: "planet" },
  { href: "/#resources", label: "Ressources", icon: "cube" },
  { href: "/#buildings", label: "Bâtiments", icon: "buildings" },
  { href: "/#laboratory", label: "Technologies", icon: "flask" },
  { href: "/#defenses", label: "Défenses", icon: "shield-star" },
  { href: "/#fleet", label: "Vaisseaux", icon: "rocket-launch" },
  { href: "/#shop", label: "Boutique", icon: "storefront" },
];
const galleryLink = { href: "/#gallery", label: "Galerie", icon: "user-circle" };
const mainLinks = [
  { href: "/blog/", label: "Blog" },
  { href: "/#community", label: "Communauté" },
  galleryLink,
  { href: "/roadmap/", label: "Roadmap" },
];
// En mobile, la galerie (les avatars) rejoint les sections du jeu : la liste de premier niveau
// reste courte. Les dynasties occupent toute la première ligne, la grille tombe juste (1 + 8 tuiles).
const mobileGameLinks = [...gameLinks, galleryLink];
const mobileMainLinks = mainLinks.filter((link) => link !== galleryLink);
---

<nav
  id="main-nav"
  class="fixed top-0 left-0 right-0 px-6 lg:px-8 transition-all duration-300 z-[999] py-5 bg-transparent"
>
  <div class="hidden lg:flex items-center justify-between h-10 w-full mx-auto">
    <div class="flex items-center justify-start">
      <a href="/">
        <img src="/logo.svg" alt="Dynasty Nova" class="h-11 w-auto" />
      </a>
    </div>
    <div class="flex items-center justify-end gap-6 xl:gap-8">
      <div class="flex items-center text-base gap-6 xl:gap-8 whitespace-nowrap">
        <div class="relative group">
          <a
            href={gameLinks[0].href}
            class="flex items-center gap-2 text-slate-300 hover:text-slate-200 transition-colors py-2"
          >
            <span>Le jeu</span>
            <i class="ph ph-bold ph-caret-down text-slate-300 text-base opacity-50"></i>
          </a>
          <div
            class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200"
          >
            <div class="bg-slate-800 border border-slate-700 rounded-md shadow-xl py-2 min-w-[200px]">
              {gameLinks.map((link) => (
                <a
                  href={link.href}
                  class="block px-4 py-2 text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors"
                >
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        </div>
        {mainLinks.map((link) => (
          <a href={link.href} class="text-slate-300 hover:text-slate-200 transition-colors py-2">
            {link.label}
          </a>
        ))}
      </div>
      <div class="flex items-center gap-4">
        <a
          href={PLAY_URL}
          class="inline-flex items-center px-4 py-2 whitespace-nowrap bg-blue-600 hover:bg-blue-500 text-slate-50 rounded-md font-semibold text-base transition-colors h-10"
        >
          Rejoindre Dynasty Nova
        </a>
      </div>
    </div>
  </div>

  <!-- Au-dessus du panneau mobile : logo et bouton restent visibles menu ouvert. -->
  <div class="lg:hidden flex items-center justify-between relative z-[1000]">
    <a href="/">
      <img src="/logo.svg" alt="Dynasty Nova" class="h-11 w-auto" />
    </a>
    <button
      id="mobile-menu-toggle"
      class="absolute top-0 right-0 flex items-center justify-center w-12 h-12 rounded-full bg-slate-950 hover:bg-slate-900/90 transition-colors overflow-hidden"
      aria-label="Ouvrir le menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <div class="relative w-6 h-6">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          fill="currentColor"
          viewBox="0 0 256 256"
          class="absolute inset-0 text-white transition-all duration-300 ease-in-out opacity-100 rotate-0 scale-100"
          id="icon-menu"
        >
          <path
            d="M224,128a8,8,0,0,1-8,8H40a8,8,0,0,1,0-16H216A8,8,0,0,1,224,128ZM40,72H216a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16ZM216,184H40a8,8,0,0,0,0,16H216a8,8,0,0,0,0-16Z"
          ></path>
        </svg>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          fill="currentColor"
          viewBox="0 0 256 256"
          class="absolute inset-0 text-white transition-all duration-300 ease-in-out opacity-0 rotate-90 scale-50"
          id="icon-close"
        >
          <path
            d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"
          ></path>
        </svg>
      </div>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="lg:hidden fixed inset-0 overflow-y-auto overscroll-contain bg-slate-950/95 backdrop-blur-xl transition-opacity duration-300 opacity-0 pointer-events-none"
    inert
  >
    <div class="min-h-full flex flex-col w-full max-w-md mx-auto px-6 pt-20 pb-6">
      <ul class="border-y border-slate-800 divide-y divide-slate-800">
        <li>
          <button
            id="mobile-game-toggle"
            class="flex w-full items-center justify-between py-3.5 text-xl font-medium text-slate-100"
            aria-expanded="false"
            aria-controls="mobile-game-links"
          >
            <span>Le jeu</span>
            <i
              class="ph ph-bold ph-caret-down text-base text-slate-400 transition-transform duration-300"
              data-caret
            ></i>
          </button>
          <div
            id="mobile-game-links"
            class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out"
            inert
          >
            <div class="overflow-hidden">
              <div class="grid grid-cols-2 gap-2 pb-4">
                {mobileGameLinks.map((link, index) => (
                  <a
                    href={link.href}
                    class:list={[
                      "flex items-center gap-2.5 min-w-0 rounded-md border border-slate-800 bg-slate-900/60 px-3 py-2.5 text-[15px] text-slate-300 hover:border-blue-500/50 hover:text-white transition-colors",
                      index === 0 && "col-span-2",
                    ]}
                  >
                    <i class={`ph ph-${link.icon} text-lg text-blue-400 shrink-0`}></i>
                    <span class="truncate">{link.label}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </li>
        {mobileMainLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="flex items-center justify-between py-3.5 text-xl font-medium text-slate-100 hover:text-blue-400 transition-colors"
            >
              {link.label}
              <i class="ph ph-bold ph-caret-right text-base text-slate-600"></i>
            </a>
          </li>
        ))}
      </ul>
      <a
        href={PLAY_URL}
        class="mt-auto pt-6 group/cta"
      >
        <span
          class="flex items-center justify-center h-12 rounded-md bg-blue-600 group-hover/cta:bg-blue-500 text-slate-50 font-semibold text-base transition-colors"
        >
          Rejoindre Dynasty Nova
        </span>
      </a>
    </div>
  </div>
</nav>

<script is:inline>
  const menuToggle = document.getElementById("mobile-menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconMenu = document.getElementById("icon-menu");
  const iconClose = document.getElementById("icon-close");
  const gameToggle = document.getElementById("mobile-game-toggle");
  const gameLinks = document.getElementById("mobile-game-links");

  const setGameOpen = (isOpen) => {
    if (!gameToggle || !gameLinks) return;
    gameToggle.setAttribute("aria-expanded", String(isOpen));
    gameLinks.classList.toggle("grid-rows-[1fr]", isOpen);
    gameLinks.classList.toggle("grid-rows-[0fr]", !isOpen);
    gameLinks.inert = !isOpen;
    gameToggle.querySelector("[data-caret]")?.classList.toggle("rotate-180", isOpen);
  };

  const setMenuOpen = (isOpen) => {
    if (!menuToggle || !mobileMenu || !iconMenu || !iconClose) return;

    mobileMenu.classList.toggle("opacity-0", !isOpen);
    mobileMenu.classList.toggle("pointer-events-none", !isOpen);
    mobileMenu.inert = !isOpen;
    // La page ne défile pas sous le panneau ouvert.
    document.documentElement.style.overflow = isOpen ? "hidden" : "";

    iconMenu.classList.toggle("opacity-0", isOpen);
    iconMenu.classList.toggle("rotate-90", isOpen);
    iconMenu.classList.toggle("scale-50", isOpen);
    iconMenu.classList.toggle("opacity-100", !isOpen);
    iconMenu.classList.toggle("rotate-0", !isOpen);
    iconMenu.classList.toggle("scale-100", !isOpen);

    iconClose.classList.toggle("opacity-100", isOpen);
    iconClose.classList.toggle("rotate-0", isOpen);
    iconClose.classList.toggle("scale-100", isOpen);
    iconClose.classList.toggle("opacity-0", !isOpen);
    iconClose.classList.toggle("rotate-90", !isOpen);
    iconClose.classList.toggle("scale-50", !isOpen);

    menuToggle.setAttribute("aria-expanded", String(isOpen));
    menuToggle.setAttribute("aria-label", isOpen ? "Fermer le menu" : "Ouvrir le menu");
    // Rouvert, le menu repart replié.
    if (!isOpen) setGameOpen(false);
  };

  menuToggle?.addEventListener("click", () => {
    setMenuOpen(menuToggle.getAttribute("aria-expanded") !== "true");
  });

  gameToggle?.addEventListener("click", () => {
    setGameOpen(gameToggle.getAttribute("aria-expanded") !== "true");
  });

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menuToggle?.getAttribute("aria-expanded") === "true") {
      setMenuOpen(false);
      menuToggle.focus();
    }
  });

  // Repassé en desktop menu ouvert : on referme, sinon le défilement resterait bloqué.
  window.matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
    if (event.matches) setMenuOpen(false);
  });

  const nav = document.getElementById("main-nav");

  window.addEventListener("scroll", () => {
    if (window.scrollY > 100) {
      // Classes à ajouter au scroll (fond sombre + bordure)
      nav.classList.add("bg-slate-900", "border-b", "border-slate-800");
      nav.classList.remove("bg-transparent");
    } else {
      // Retour à l'état initial (transparent)
      nav.classList.remove("bg-slate-900", "border-b", "border-slate-800");
      nav.classList.add("bg-transparent");
    }
  });
</script>

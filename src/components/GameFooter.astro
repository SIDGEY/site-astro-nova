---
// Footer minimaliste pour Dynasty Nova
import { pathFor, t, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---
<footer class="bg-slate-900 border-t border-slate-800 px-6 lg:px-8 py-6 sm:py-5">
  <div class="flex flex-col gap-4 sm:flex-row sm:justify-between sm:items-center sm:h-10 w-full">
    <p class="text-slate-500 text-sm leading-none m-0">{t(locale, "footer.rights")}</p>
    <nav class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
      <a href={pathFor("privacy", locale)} class="text-slate-500 hover:text-slate-200 transition-colors">{t(locale, "footer.privacy")}</a>
      <a href={pathFor("terms", locale)} class="text-slate-500 hover:text-slate-200 transition-colors">{t(locale, "footer.terms")}</a>
      <a href={pathFor("cookies", locale)} class="text-slate-500 hover:text-slate-200 transition-colors">{t(locale, "footer.cookies")}</a>
    </nav>
  </div>
</footer>

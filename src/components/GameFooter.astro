---
// Footer minimaliste pour Dynasty Nova. Les pages légales n'existent qu'en français : en
// anglais, le libellé le dit.
interface Props {
  lang?: "fr" | "en";
}
const { lang = "fr" } = Astro.props;
const t =
  lang === "en"
    ? { rights: "All rights reserved.", privacy: "Privacy policy (in French)", terms: "Terms of use (in French)", cookies: "Cookies (in French)" }
    : { rights: "Tous droits réservés.", privacy: "Politique de confidentialité", terms: "Conditions d'utilisation", cookies: "Cookies" };
---
<footer class="bg-slate-900 border-t border-slate-800 px-6 lg:px-8 py-6 sm:py-5">
  <div class="flex flex-col gap-4 sm:flex-row sm:justify-between sm:items-center sm:h-10 w-full">
    <p class="text-slate-500 text-sm leading-none m-0">© 2026 Dynasty Nova. {t.rights}</p>
    <nav class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
      <a href="/politique-de-confidentialite/" class="text-slate-500 hover:text-slate-200 transition-colors">{t.privacy}</a>
      <a href="/conditions-generales/" class="text-slate-500 hover:text-slate-200 transition-colors">{t.terms}</a>
      <a href="/cookies/" class="text-slate-500 hover:text-slate-200 transition-colors">{t.cookies}</a>
    </nav>
  </div>
</footer>

---
import { getEntry } from 'astro:content';
import { LOCALE_META, LOCALES, X_DEFAULT_LOCALE, type Alternates, type Locale } from '../lib/i18n';
import {
  SITE_NAME,
  DEFAULT_DESCRIPTIONS,
  DEFAULT_OG_IMAGE,
  getCanonicalURL,
  formatTitle,
  getOrganizationSchema,
  getWebSiteSchema,
  getWebPageSchema,
  getBreadcrumbSchema,
  getArticleSchema,
  getVideoGameSchema,
  getFaqSchema
} from '../lib/seo';

const settingsEntry = await getEntry('settings', 'general');
const siteName = settingsEntry?.data.siteName || SITE_NAME;

interface BreadcrumbItem {
  name: string;
  item: string;
}

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  index?: boolean;
  follow?: boolean;
  articleData?: {
    datePublished: Date;
    author: string;
  };
  breadcrumbs?: BreadcrumbItem[];
  faqItems?: { question: string; answer: string }[];
  locale: Locale;
  /** Les deux versions de la page ; le hreflang n'est émis que si `hreflang` le permet. */
  alternates?: Alternates;
  hreflang?: boolean;
}

const locale = Astro.props.locale;
const {
  title,
  description = locale === 'fr' ? settingsEntry?.data.defaultDescription || "" : DEFAULT_DESCRIPTIONS[locale],
  image = DEFAULT_OG_IMAGE,
  canonicalURL = Astro.props.canonicalURL || getCanonicalURL(Astro.url.pathname || ""),
  type = 'website',
  index = true,
  follow = true,
  articleData,
  breadcrumbs,
  faqItems,
  alternates = {},
  hreflang = true
} = Astro.props;

const formattedTitle = title.includes('|') ? title : `${title} | ${siteName}`;
const robots = `${index ? 'index' : 'noindex'}, ${follow ? 'follow' : 'nofollow'}`;
const ogImageURL = image.startsWith('http') ? image : new URL(image, Astro.site);

// hreflang réciproques, seulement entre deux pages indexables qui existent toutes les deux : un
// hreflang vers (ou depuis) une page noindex fait ignorer toute la paire par Google.
const languageLinks =
  index && hreflang && LOCALES.every((l) => alternates[l])
    ? [
        ...LOCALES.map((l) => ({ hreflang: LOCALE_META[l].htmlLang, href: new URL(alternates[l]!, Astro.site).href })),
        { hreflang: 'x-default', href: new URL(alternates[X_DEFAULT_LOCALE]!, Astro.site).href },
      ]
    : [];
const otherLocales = LOCALES.filter((l) => l !== locale && alternates[l]);

// JSON-LD Graph construction
const schemas = [
  getOrganizationSchema(),
  getWebSiteSchema(locale),
  getVideoGameSchema(locale),
  getWebPageSchema(formattedTitle, description, canonicalURL, locale)
];

if (breadcrumbs && breadcrumbs.length > 0) {
  schemas.push(getBreadcrumbSchema(breadcrumbs));
}

if (type === 'article' && articleData) {
  schemas.push(getArticleSchema({
    title,
    description,
    url: canonicalURL,
    image,
    datePublished: articleData.datePublished,
    author: articleData.author,
    locale
  }));
}

if (faqItems && faqItems.length > 0) {
  schemas.push(getFaqSchema(faqItems, canonicalURL));
}

const jsonLdGraph = {
  "@context": "https://schema.org",
  "@graph": schemas
};
---

<!-- Global Metadata -->
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Robots -->
<meta name="robots" content={robots} />

<!-- Primary Meta Tags -->
<title>{formattedTitle}</title>
<meta name="title" content={formattedTitle} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:locale" content={LOCALE_META[locale].og} />
{otherLocales.map((l) => <meta property="og:locale:alternate" content={LOCALE_META[l].og} />)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={formattedTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageURL} />

<!-- Hreflang -->
{languageLinks.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}

<!-- JSON-LD Graph -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdGraph)} />

<!-- Google Fonts Preconnect (moved from old SEO.astro) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

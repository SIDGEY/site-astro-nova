---
// En-tête des pages d'atterrissage en anglais (src/content/pages/en/) : le menu du site renvoie
// vers une home en français, inutile à un visiteur anglophone venu d'une publicité. Logo et
// bouton vers le jeu seulement.
const PLAY_URL = "https://play.dynastynova.com";
---

<nav
  id="main-nav"
  class="fixed top-0 left-0 right-0 px-6 lg:px-8 transition-all duration-300 z-[999] py-5 bg-transparent"
>
  <div class="flex items-center justify-between h-10 w-full mx-auto">
    <img src="/logo.svg" alt="Dynasty Nova" class="h-11 w-auto" />
    <a
      href={PLAY_URL}
      class="inline-flex items-center px-4 py-2 whitespace-nowrap bg-blue-600 hover:bg-blue-500 text-slate-50 rounded-md font-semibold text-base transition-colors h-10"
    >
      Play for free
    </a>
  </div>
</nav>

<script is:inline>
  const nav = document.getElementById("main-nav");
  window.addEventListener("scroll", () => {
    const scrolled = window.scrollY > 100;
    nav.classList.toggle("bg-slate-900", scrolled);
    nav.classList.toggle("border-b", scrolled);
    nav.classList.toggle("border-slate-800", scrolled);
    nav.classList.toggle("bg-transparent", !scrolled);
  });
</script>

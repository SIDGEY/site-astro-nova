---
// La page contact des deux langues (/contact/, /en/contact/) : un gabarit, les textes par langue.
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_URL } from "../lib/seo";
import { LOCALES, pathFor, t, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const COPY = {
  fr: {
    title: "Contact",
    description: "Contactez l'équipe de Dynasty Nova pour toute question ou support.",
    heading: "Contactez le",
    headingAccent: "Commandement.",
    intro:
      "Une question sur le jeu, un bug à signaler ou une demande de partenariat ? Nos fréquences sont ouvertes.",
    name: "Nom du Commandant",
    namePlaceholder: "Votre pseudo",
    email: "Fréquence (Email)",
    emailPlaceholder: "vous@exemple.com",
    message: "Transmission",
    messagePlaceholder: "Votre message...",
    submit: "Initier la transmission",
    channels: "Canaux Officiels",
    channelsText:
      "Pour le support rapide et les échanges avec la communauté, rejoignez notre Discord.",
    discord: "Rejoindre le Discord →",
    direct: "Support Direct",
    press: "Presse & Créateurs",
    pressText: "Vous souhaitez couvrir la sortie de Dynasty Nova ?",
    pressKit: "Dossier de presse →",
  },
  en: {
    title: "Contact",
    description: "Contact the Dynasty Nova team for any question or support request.",
    heading: "Contact",
    headingAccent: "High Command.",
    intro:
      "A question about the game, a bug to report or a partnership request? Our frequencies are open.",
    name: "Commander name",
    namePlaceholder: "Your username",
    email: "Frequency (email)",
    emailPlaceholder: "you@example.com",
    message: "Transmission",
    messagePlaceholder: "Your message...",
    submit: "Begin transmission",
    channels: "Official Channels",
    channelsText: "For quick support and to chat with the community, join our Discord.",
    discord: "Join the Discord →",
    direct: "Direct Support",
    press: "Press & Creators",
    pressText: "Want to cover the release of Dynasty Nova?",
    pressKit: "Press kit →",
  },
} satisfies Record<Locale, Record<string, string>>;
const c = COPY[locale];

const breadcrumbs = [
  { name: t(locale, "crumb.home"), item: `${SITE_URL}${pathFor("home", locale)}` },
  { name: c.title, item: `${SITE_URL}${pathFor("contact", locale)}` },
];
const alternates = Object.fromEntries(LOCALES.map((l) => [l, pathFor("contact", l)]));
---

<BaseLayout
  title={c.title}
  description={c.description}
  breadcrumbs={breadcrumbs}
  {alternates}
>
  <section class="py-24 relative overflow-hidden bg-slate-900">
    <div class="container-custom relative z-10">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16">
          <h1 class="text-5xl md:text-6xl font-extrabold mb-6 text-slate-50">
            {c.heading} <span class="text-blue-500">{c.headingAccent}</span>
          </h1>
          <p class="text-xl text-slate-400">
            {c.intro}
          </p>
        </div>

        <div
          class="grid grid-cols-1 md:grid-cols-2 gap-12 bg-slate-800/50 p-8 md:p-12 rounded-[40px] border border-slate-700 shadow-xl backdrop-blur-sm"
        >
          <!-- Formulaire -->
          <form class="space-y-6">
            <div>
              <label
                for="name"
                class="block text-sm font-bold mb-2 text-slate-300"
                >{c.name}</label
              >
              <input
                type="text"
                id="name"
                class="w-full bg-slate-900 border border-slate-700 rounded-lg p-3 text-slate-200 focus:border-blue-500 outline-none transition-colors"
                placeholder={c.namePlaceholder}
              />
            </div>
            <div>
              <label
                for="email"
                class="block text-sm font-bold mb-2 text-slate-300"
                >{c.email}</label
              >
              <input
                type="email"
                id="email"
                class="w-full bg-slate-900 border border-slate-700 rounded-lg p-3 text-slate-200 focus:border-blue-500 outline-none transition-colors"
                placeholder={c.emailPlaceholder}
              />
            </div>
            <div>
              <label
                for="message"
                class="block text-sm font-bold mb-2 text-slate-300"
                >{c.message}</label
              >
              <textarea
                id="message"
                rows="4"
                class="w-full bg-slate-900 border border-slate-700 rounded-lg p-3 text-slate-200 focus:border-blue-500 outline-none transition-colors"
                placeholder={c.messagePlaceholder}></textarea>
            </div>
            <button
              type="submit"
              class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg transition-colors shadow-lg shadow-blue-900/20"
              >{c.submit}</button
            >
          </form>

          <!-- Infos de contact -->
          <div class="flex flex-col justify-between space-y-12">
            <div>
              <h3 class="text-2xl font-bold mb-6 text-white">
                {c.channels}
              </h3>
              <div class="space-y-4 text-slate-400">
                <p>
                  {c.channelsText}
                </p>
                <a
                  href="https://discord.gg/dVXdVqw5d5"
                  class="inline-flex items-center gap-2 text-blue-400 hover:text-blue-300 transition-colors font-medium"
                >
                  {c.discord}
                </a>
              </div>
            </div>
            <div>
              <h3 class="text-2xl font-bold mb-4 text-white">{c.direct}</h3>
              <p class="text-slate-400">contact@dynastynova.com</p>
            </div>
            <div
              class="p-6 bg-blue-900/20 rounded-2xl border border-blue-500/20"
            >
              <p class="font-bold text-blue-400 mb-2">{c.press}</p>
              <p class="text-sm text-slate-400 mb-4">
                {c.pressText}
              </p>
              <a
                href="#"
                class="text-sm font-bold text-white underline hover:text-blue-400 transition-colors"
                >{c.pressKit}</a
              >
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Décoration -->
    <div
      class="absolute bottom-0 left-0 -z-10 w-96 h-96 bg-blue-900/20 rounded-full blur-[100px]"
    >
    </div>
  </section>
</BaseLayout>

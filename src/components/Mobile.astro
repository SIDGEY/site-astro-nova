---
/**
 * Cadre de téléphone. L'écran est soit un écran reconstruit du jeu passé en slot
 * (`components/game/`), soit, à défaut, une image (`screenshot`).
 */
interface Props {
    screenshot?: string;
    dataRole?: string;
    /** Ombre portée du cadre ; le hero pose la sienne, plus diffuse, sans filtre. */
    shadow?: boolean;
}

const { screenshot, dataRole, shadow = true } = Astro.props;
const hasScreen = Astro.slots.has('default');
---

<div class:list={['relative block w-fit', shadow && 'drop-shadow-2xl']} data-role={dataRole}>
    <!-- Le téléphone (SVG) qui définit la taille du conteneur -->
    <img
        src="/tel.svg"
        alt=""
        class="relative w-[232px] md:h-[480px] h-auto pointer-events-none z-10"
    />

    <!-- L'écran, placé derrière le cadre du téléphone -->
    {
        (hasScreen || screenshot) && (
            <div class="absolute inset-0 z-0 bg-[#0F141E] rounded-[2.5rem] overflow-hidden flex justify-center items-center">
                {hasScreen ? (
                    <div class="relative w-[216px] h-[466px] rounded-[26px] overflow-hidden" data-screen-stack>
                        <slot />
                    </div>
                ) : (
                    <img
                        src={screenshot}
                        alt="Screenshot"
                        class="z-50 w-[216px] h-[466px] object-cover rounded-[1rem]"
                    />
                )}
            </div>
        )
    }
</div>
